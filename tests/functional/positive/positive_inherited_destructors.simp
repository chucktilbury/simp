# Exercises inherited and overridden destruction across single, multiple, and diamond inheritance, including failures.
class Primary {
  int primaryCode
  void destroy() {
    print(primaryCode)
  }
}

class Secondary {
  int secondaryCode
  void destroy() {
    print(secondaryCode)
  }
}

class Single : Primary {
  int ownCode
  Single(int code) {
    super.Primary()
    primaryCode = code
    ownCode = code + 1
  }
  void destroy() {
    print(ownCode)
  }
}

class Multiple : Primary, Secondary {
  int ownCode
  Multiple(int code) {
    super.Primary()
    primaryCode = code
    secondaryCode = code + 1
    ownCode = code + 2
  }
  void destroy() {
    print(ownCode)
  }
}

class InheritedOnly : Primary, Secondary {
  InheritedOnly(int code) {
    super.Primary()
    primaryCode = code
    secondaryCode = code + 1
  }
}

class Maker {
  void makeUnreachable() {
    Multiple temporary = Multiple(1)
  }
}

class ThrowingBase {
  void destroy() {
    print("base after derived error")
    raise "base destructor failure"
  }
}

class ThrowingDerived : ThrowingBase {
  ThrowingDerived() {
    super.ThrowingBase()
  }
  void destroy() {
    raise "derived destructor failure"
  }
}

class Root {
  void destroy() {
    print("root subobject")
  }
}

class Left : Root {
}

class Right : Root {
}

class Diamond : Left, Right {
  Diamond() {
    super.Left()
  }
  void destroy() {
    print("diamond")
  }
}

start {
  Single single = Single(10)
  single.destroy()
  Primary baseView = Single(30)
  baseView.destroy()

  Maker maker = Maker()
  maker.makeUnreachable()
  Multiple explicit = Multiple(4)
  explicit.destroy()
  Multiple trigger = Multiple(20)

  ThrowingDerived throwing = ThrowingDerived()
  try {
    throwing.destroy()
  } except failure {
    print(failure)
  }
  try {
    throwing.destroy()
  } except repeated {
    print("caught repeated destruction")
  }

  Diamond diamond = Diamond()
  diamond.destroy()

  InheritedOnly inheritedOnly = InheritedOnly(50)
  inheritedOnly.destroy()
}
