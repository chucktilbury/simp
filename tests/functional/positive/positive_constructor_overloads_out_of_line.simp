class OutOfLine {
    OutOfLine(int value)
    OutOfLine(string value)
}

OutOfLine OutOfLine.OutOfLine(int value) {
    print("out int")
}

OutOfLine OutOfLine.OutOfLine(string value) {
    print("out string")
}

start {
    OutOfLine integer = OutOfLine(1)
    OutOfLine text = OutOfLine("value")
}
