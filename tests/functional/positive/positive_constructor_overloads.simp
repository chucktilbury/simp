class RootTag {
    RootTag() {}
}

class DerivedTag : RootTag {
    DerivedTag() {
        super.RootTag()
    }
}

class Pick {
    Pick() {
        print("zero")
    }

    Pick(int value) {
        print("int")
    }

    Pick(int first, int second) {
        print("two")
    }

    Pick(strg value) {
        print("string")
    }

    Pick(RootTag value) {
        print("root")
    }

    Pick(DerivedTag value) {
        print("derived")
    }
}

class BaseOnly {
    BaseOnly(RootTag value) {
        print("base-only")
    }
}

class MethodChoice {
    int choose(RootTag value) {
        return 1
    }

    int choose(DerivedTag value) {
        return 2
    }
}

class Base {
    Base(int value) {
        print("base int")
    }

    Base(strg value) {
        print("base string")
    }
}

class ChildBase : Base {
    ChildBase(int value) {
        super.Base(value)
    }
}

class VirtualRoot {
    VirtualRoot(int value) {
        print("virtual int")
    }

    VirtualRoot(strg value) {
        print("virtual string")
    }
}

class VirtualChild : virtual VirtualRoot {
    VirtualChild(strg value) {
        super.virtual VirtualRoot(value)
    }
}

class Empty {}

start {
    Pick zero = Pick()
    Pick integer = Pick(1)
    Pick pair = Pick(1, 2)
    Pick text = Pick("value")

    RootTag root = RootTag()
    DerivedTag child = DerivedTag()
    Pick rootChoice = Pick(root)
    Pick childChoice = Pick(child)
    BaseOnly baseOnly = BaseOnly(child)

    MethodChoice methods = MethodChoice()
    print(methods.choose(child))

    ChildBase base = ChildBase(8)
    VirtualChild virtualChild = VirtualChild("value")
    Empty empty = Empty()
}
