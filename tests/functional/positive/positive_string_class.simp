class Text {
    strg wrap(strg value) {
        return "[{}]"(value)
    }
}

class ExtendedString : String {
    ExtendedString() {
        super.String()
    }
}

class Order {
    int count
    int next() {
        count = count + 1
        return count
    }
}

start {
    strg original = "hi"
    String alias = original
    print(original == alias)
    alias.append("!")
    print(original)
    print(original.length)
    print(original.equals("hi!"))
    print(original == "hi!")
    print(original is String)
    print(original is strg)
    print(type(original) == String)
    print(type(original) == strg)
    ExtendedString derived = ExtendedString()
    print(derived is String)
    String base = derived
    print(base.length)
    derived.append("x")
    print(base)

    strg formatted = "value {} {}"(42, true)
    print(formatted)
    Order order = Order()
    strg ordered = "{} {}"(order.next(), order.next())
    print(ordered)
    print(order.count)
    print(Text().wrap(original))
    array values = ["array {}"(original)]
    strg item = values[0]
    print(item)
    map formattedKey = {"key {}"(1): 7}
    print(formattedKey["key 1"])
    map lookup = {"key": 1}
    strg key = "key"
    lookup[key] = 5
    key.append("!")
    print(lookup["key"])
    print(lookup.contains("key"))
    print("9".toInt())
    print("11".toUnsigned())
    print("1.5".toFloat())
    strg empty = null
    print(empty == null)
    print(type(empty))
    print(original.find("h"))
}
