class Node {
    int value
    Node next

    Node(int initial) {
        value = initial
    }

    void setNext(Node child) {
        next = child
    }
}

class Pair {
    Node child

    Pair(Node value) {
        child = value
    }
}

start {
    Node head = Node(0)
    Node tail = head
    int index = 1
    while (index <= 64) {
        tail.setNext(Node(index))
        tail = tail.next
        index = index + 1
    }
    print(head.next.value)
    print(tail.value)

    Pair pair = Pair(Node(77))
    print(pair.child.value)
}
