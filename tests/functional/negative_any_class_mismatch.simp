class Cat {
    int lives
    Cat(int initial) {
        lives = initial
    }
}

class Dog {
    int loyalty
    Dog(int initial) {
        loyalty = initial
    }
}

start {
    // Extraction into a class type requires an exact runtime class match;
    // this prototype does not support polymorphic/covariant downcasts.
    array pets = [Cat(9), Dog(1)]
    Dog mismatched = pets[0]
    print(mismatched.loyalty)
}
