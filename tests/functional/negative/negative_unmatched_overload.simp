# Rejects a call whose argument types match no overload. Simple has no
# implicit conversions, so overload resolution is an exact-match rule: a
# bool argument does not silently select the int or float overload.
class Printer {
    Printer() {}

    int show(int value) {
        return value
    }

    int show(float value) {
        return 2
    }
}

start {
    Printer p = Printer()
    bool flag = true
    print(p.show(flag))
}
