class Node {
    int value;

    Node(int initial) {
        value = initial;
    }
}

class Root {
    Node item;
    int value;

    int read() {
        return value;
    }
}

class Left : Root {
    int left;

    int sum() {
        return value + left;
    }
}

class Right : Root {
    int right;

    int sumRight() {
        return value + right;
    }
}

class Diamond : Left, Right {
    int extra;

    int sum() {
        return left + extra;
    }
}

start {
    Diamond diamond = Diamond();
    diamond.Left.Root.item = Node(10);
    diamond.Right.Root.item = Node(20);
    diamond.Left.Root.value = 10;
    diamond.Right.Root.value = 20;
    diamond.Left.left = 2;
    diamond.Right.right = 3;
    diamond.extra = 5;

    Left leftView = diamond;
    print(leftView.sum());
    print(diamond.Left.sum());
    print(diamond.Left.Root.item.value);
    print(diamond.Right.Root.item.value);
    print(diamond.Right.right);
}
