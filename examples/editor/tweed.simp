class EditorDocument {
    GtkSource.View view
    Gtk.ScrolledWindow scroller
    String path
    list shortcuts
    bool shortcutConflict
    int shortcutRevision

    EditorDocument(String filePath, String contents) {
        path = filePath
        shortcuts = []
        shortcutConflict = false
        view = GtkSource.View()
        view.setMonospace(true)
        view.setLanguage(GtkSource.Content().languageFor(filePath))
        view.setText(contents)
        view.markSaved()
        scroller = Gtk.ScrolledWindow()
        scroller.setHExpand(true)
        scroller.setVExpand(true)
        view.widget().setHExpand(true)
        view.widget().setVExpand(true)
        scroller.setChild(view.widget())
    }

    String tabTitle() {
        String title = "Untitled"
        if (!path.equals("")) {
            title = System.FileSystem().basename(path)
        }
        if (view.modified()) {
            title.append("*")
        }
        return title
    }
}

class ProjectNode {
    ProjectNode _self()
    ProjectExplorer explorer
    Gtk.DirectoryScan scan
    int id
    int generation
    int kind
    String path
    bool started
    bool populated
    bool complete
    String error

    ProjectNode(ProjectExplorer owner, int row, String filePath, int entryKind) {
        explorer = owner
        path = filePath
        kind = entryKind
        generation = owner.generation
        id = row
        error = ""
    }

    void load() {
        if (kind != 1 || started) { return }
        started = true
        explorer.addMessage(id, "Loading...", "content-loading-symbolic")
        scan = Gtk.DirectoryScan(explorer.tree, path, explorer.hidden.active(), explorer.rootPath,
            explorer.excludes, _self().received)
    }

    void received(int count, String message) {
        if (generation != explorer.generation || explorer.tree.disposed()) { return }
        if (!populated) {
            populated = true
            explorer.tree.clear(id)
        }
        if (count == -1) {
            complete = true
            scan = null
            error = message
            if (!error.equals("")) {
                explorer.addMessage(id, format("Could not read directory: {}", error), "dialog-error-symbolic")
            } else {
                if (explorer.tree.childCount(id) == 0) {
                    explorer.addMessage(id, "(Empty folder)", "folder-symbolic")
                }
                explorer.restoreChildren(path)
            }
            return
        }
        scan.append(explorer.tree, id, explorer.nextId + 1, count, explorer.icons)
        explorer.nextId = explorer.nextId + count
    }
}
ProjectNode ProjectNode._self() from "simp_gtk_self"

class ProjectExplorer {
    ProjectExplorer _self()
    Gtk.Box sidebar
    Gtk.Tree tree
    Gtk.Label title
    Gtk.CheckButton hidden
    Gtk.Button refreshButton
    String excludes
    list pending
    list nodes
    int nextId
    int generation
    String rootPath
    String icons
    callback<void(String)> open

    ProjectExplorer(callback<void(String)> openFile) {
        open = openFile
        nodes = []
        rootPath = ""
        excludes = ""
        pending = []
        icons = "0=text-x-generic-symbolic\n1=folder-symbolic\n2=emblem-symbolic-link-symbolic\n3=dialog-warning-symbolic\n.simp=text-x-script-symbolic\n.tweed=text-x-script-symbolic\n.c=text-x-script-symbolic\n.h=text-x-script-symbolic\n.py=text-x-script-symbolic\n.png=image-x-generic-symbolic\n.jpg=image-x-generic-symbolic\n.svg=image-x-generic-symbolic"
        sidebar = Gtk.Box(Gtk.Box.VERTICAL, 4)
        sidebar.setVExpand(true)
        title = Gtk.Label("Project Explorer")
        sidebar.append(title)
        refreshButton = Gtk.Button("Refresh")
        refreshButton.setSensitive(false)
        refreshButton.onClicked(_self().refresh)
        sidebar.append(refreshButton)
        hidden = Gtk.CheckButton("Show Hidden Files")
        hidden.onToggled(_self().hiddenChanged)
        sidebar.append(hidden)
        tree = Gtk.Tree(_self().expand, _self().activateFile)
        tree.setHExpand(true)
        tree.setVExpand(true)
        Gtk.ScrolledWindow scroll = Gtk.ScrolledWindow()
        scroll.setHExpand(true)
        scroll.setVExpand(true)
        scroll.setChild(tree)
        sidebar.append(scroll)
        addMessage(0, "Use File > Open Folder...", "folder-open-symbolic")
    }

    void addMessage(int parent, String text, String image) {
        nextId = nextId + 1
        tree.add(parent, nextId, text, image, false, "", -1)
    }

    void cancelLoads() {
        generation = generation + 1
        int i = 0
        while (i < nodes.length) {
            ProjectNode node = nodes[i] as ProjectNode
            if (node.scan != null) {
                node.scan.cancel()
                node.scan = null
            }
            i = i + 1
        }
    }

    void setRoot(String path) { setProject(path, "Project Explorer", "", []) }

    // expandedPaths are absolute directories re-expanded as their parents load.
    void setProject(String path, String label, String patterns, list expandedPaths) {
        rootPath = path
        excludes = patterns
        title.setText(label)
        refreshButton.setSensitive(true)
        refresh()
        pending = expandedPaths
    }

    void restoreChildren(String parent) {
        list ready = []
        list remaining = []
        int i = 0
        while (i < pending.length) {
            String path = pending[i] as String
            if (System.FileSystem().dirname(path).equals(parent)) { ready.append(path) } else { remaining.append(path) }
            i = i + 1
        }
        pending = remaining
        i = 0
        while (i < ready.length) {
            int id = tree.findValue(ready[i] as String)
            if (id > 1 && tree.data(id) == 1) { tree.setExpanded(id, true) }
            i = i + 1
        }
    }

    // Expanded directories (absolute), including restores still waiting for a parent scan.
    list expandedPaths() {
        list result = []
        if (rootPath.equals("") || tree.disposed()) { return result }
        int i = 0
        while (i < nodes.length) {
            ProjectNode node = nodes[i] as ProjectNode
            if (node.id != 1 && tree.expanded(node.id)) { result.append(node.path) }
            i = i + 1
        }
        i = 0
        while (i < pending.length) {
            result.append(pending[i] as String)
            i = i + 1
        }
        return result
    }

    void refresh() {
        if (rootPath.equals("") || tree.disposed()) { return }
        pending = []
        cancelLoads()
        tree.clear(0)
        nodes = []
        nextId = 1
        tree.add(0, 1, rootPath, "folder-open-symbolic", true, rootPath, 1)
        tree.setExpanded(1, true)
    }

    void hiddenChanged(bool value) { refresh() }

    void expand(int id) {
        int i = 0
        while (i < nodes.length) {
            if ((nodes[i] as ProjectNode).id == id) { return }
            i = i + 1
        }
        if (tree.data(id) == 1) {
            ProjectNode node = ProjectNode(_self(), id, tree.value(id), 1)
            nodes.append(node)
            node.load()
        }
    }

    void activateFile(int id) {
        int kind = tree.data(id)
        if (kind >= 0 && kind != 1) { open(tree.value(id)) }
    }
}
ProjectExplorer ProjectExplorer._self() from "simp_gtk_self"

