import gtk
import sourceview
import system

class CommandBinding {
    String id
    String name
    String defaultTrigger
    String trigger
    String normalized
    bool valid
    callback<void()> action
    CommandBinding(String command, String label, String shortcut) {
        id = command
        name = label
        defaultTrigger = shortcut
        setTrigger(shortcut)
    }
    void setTrigger(String shortcut) {
        trigger = shortcut
        normalized = ""
        if (!shortcut.equals("")) { normalized = Gtk.Keyboard().normalize(shortcut) }
        valid = shortcut.equals("") || normalized.length > 0
    }
}

class TweedSettings {
    String fontFamily
    int fontSize
    int tabWidth
    bool insertSpaces
    bool lineNumbers
    bool wrap
    bool highlightLine
    bool reopenLast
    String lastRoot
    list commands
    String path
    String original
    String errors
    bool writable
    bool legacyConflict
    int shortcutRevision

    TweedSettings() {
        resetEditor()
        commands = [
            CommandBinding("new", "New document", "<Control>n"),
            CommandBinding("open", "Open files", "<Control>o"),
            CommandBinding("save", "Save", "<Control>s"),
            CommandBinding("save-as", "Save as", "<Control><Shift>s"),
            CommandBinding("close", "Close tab", "<Control>w"),
            CommandBinding("quit", "Quit", "<Control>q"),
            CommandBinding("find", "Find", "<Control>f"),
            CommandBinding("replace", "Find and replace", "<Control>h"),
            CommandBinding("undo", "Undo", "<Control>z"),
            CommandBinding("redo", "Redo", "<Control><Shift>z"),
            CommandBinding("cut", "Cut", "<Control>x"),
            CommandBinding("copy", "Copy", "<Control>c"),
            CommandBinding("paste", "Paste", "<Control>v"),
            CommandBinding("select-all", "Select all", "<Control>a"),
            CommandBinding("preferences", "Preferences", "<Control>comma"),
            CommandBinding("project-new", "New project", ""),
            CommandBinding("project-open", "Open project", ""),
            CommandBinding("project-save", "Save project", ""),
            CommandBinding("project-save-as", "Save project as", ""),
            CommandBinding("project-delete", "Delete project metadata", ""),
            CommandBinding("project-configure", "Configure project", ""),
            CommandBinding("about", "About Tweed", "")
        ]
        reopenLast = false
        lastRoot = ""
        original = ""
        errors = ""
        writable = true
        legacyConflict = false
        shortcutRevision = 1
        String configHome = System.Process().getEnv("XDG_CONFIG_HOME")
        if (configHome.equals("")) {
            configHome = System.FileSystem().join(System.Process().getEnv("HOME"), ".config")
        }
        path = System.FileSystem().join(configHome, "tweed/settings.toml")
        if (!configHome.startsWith("/")) {
            error("XDG_CONFIG_HOME (or HOME fallback) must be an absolute path")
        }
        load()
    }

    void resetEditor() {
        fontFamily = "monospace"
        fontSize = 12
        tabWidth = 4
        insertSpaces = true
        lineNumbers = true
        wrap = false
        highlightLine = false
    }

    void error(String message) {
        if (!errors.equals("")) { errors.append("\n") }
        errors.append(message)
        writable = false
    }

    CommandBinding command(String id) {
        int i = 0
        while (i < commands.length) {
            CommandBinding binding = commands[i] as CommandBinding
            if (binding.id.equals(id)) { return binding }
            i = i + 1
        }
        return null
    }

    String bindingError(CommandBinding binding, String trigger) {
        if (trigger.equals("")) { return "" }
        String normalized = binding.normalized
        if (!trigger.equals(binding.trigger)) { normalized = Gtk.Keyboard().normalize(trigger) }
        if (normalized.equals("")) { return format("Invalid shortcut trigger: {}", trigger) }
        int i = 0
        while (i < commands.length) {
            CommandBinding other = commands[i] as CommandBinding
            if (other != binding && !other.trigger.equals("") &&
                other.normalized.equals(normalized)) {
                return format("Shortcut conflicts with {}: {}", other.name, trigger)
            }
            i = i + 1
        }
        return ""
    }

    void loadLegacy() {
        String legacy = "tweed-shortcuts.conf"
        String presence = Gtk.Config().fileStatus(legacy)
        if (presence.equals("missing")) { return }
        if (presence.length > 0) {
            error(format("Could not read tweed-shortcuts.conf: {}", presence))
            return
        }
        System.File file = System.File(legacy, "r")
        if (!file.isOpen()) {
            error("Could not read tweed-shortcuts.conf")
            return
        }
        list lines = file.readLines()
        String readError = System.System().lastError()
        file.close()
        if (!readError.equals("")) {
            error(readError)
            return
        }
        // Legacy files replaced the entire default map. Preserve that behavior.
        int i = 0
        while (i < commands.length) {
            (commands[i] as CommandBinding).setTrigger("")
            i = i + 1
        }
        i = 0
        while (i < lines.length) {
            String line = (lines[i] as String).trim()
            if (!line.equals("")) {
                list fields = line.split("=")
                if (fields.length != 2) {
                    error(format("Invalid shortcut config line {}", i + 1))
                } else {
                    CommandBinding binding = command((fields[1] as String).trim())
                    String trigger = (fields[0] as String).trim()
                    if (binding == null) {
                        error(format("Unknown legacy shortcut command: {}", fields[1] as String))
                    } else {
                        String problem = bindingError(binding, trigger)
                        if (trigger.length == 0) { problem = "Empty legacy shortcut trigger" }
                        if (!problem.equals("")) {
                            legacyConflict = true
                            error(problem)
                        } else {
                            if (!binding.trigger.equals("")) {
                                error(format("Duplicate legacy command: {}", binding.id))
                            } else { binding.setTrigger(trigger) }
                        }
                    }
                }
            }
            i = i + 1
        }
        CommandBinding preferences = command("preferences")
        if (preferences.trigger.length == 0 && bindingError(preferences, preferences.defaultTrigger).length == 0) {
            preferences.setTrigger(preferences.defaultTrigger)
        }
    }

    String value(String section, String key) {
        return Gtk.Config().value(original, section, key)
    }

    int integer(String key, int fallback, int minimum, int maximum) {
        String raw = value("editor", key)
        if (raw.equals("")) { return fallback }
        if (raw.startsWith("i")) {
            int number = raw.slice(1, raw.length).toInt()
            if (number >= minimum && number <= maximum) { return number }
        }
        error(format("editor.{} must be an integer from {} to {}", key, minimum, maximum))
        return fallback
    }

    bool boolean(String key, bool fallback) {
        String raw = value("editor", key)
        if (raw.equals("")) { return fallback }
        if (raw.equals("btrue")) { return true }
        if (raw.equals("bfalse")) { return false }
        error(format("editor.{} must be a boolean", key))
        return fallback
    }

    String fontError(String font) {
        if (font.trim().equals("") || font.length > 128 || font.contains("\n") ||
            font.contains("\r") || font.contains("\t")) {
            return "Font family must be 1-128 characters, without control characters"
        }
        if (!Gtk.Font().isMonospace(font)) { return "Choose an installed monospace font family (or monospace)" }
        return ""
    }

    void load() {
        String presence = Gtk.Config().fileStatus(path)
        if (presence.equals("missing")) {
            loadLegacy()
            return
        }
        if (presence.length > 0) {
            error(format("Could not read settings: {}", presence))
            return
        }
        if (!System.FileSystem().isFile(path) || System.FileSystem().fileSize(path) > 65536) {
            error("Settings must be a regular TOML file no larger than 64 KiB")
            return
        }
        System.File file = System.File(path, "r")
        if (!file.isOpen()) {
            error(format("Could not read settings: {}", System.System().lastError()))
            return
        }
        try { original = file.readAll() }
        except(Exception) as failure { error(failure.message) }
        String readError = System.System().lastError()
        file.close()
        if (!readError.equals("")) { error(readError) }
        if (!GtkSource.Content().isText(original)) {
            error("Malformed settings TOML: embedded NUL bytes")
            return
        }
        String malformed = Gtk.Config().validate(original)
        if (!malformed.equals("")) {
            error(format("Malformed settings TOML: {}", malformed))
            return
        }
        if (!value("", "version").equals("i1")) {
            error("Unsupported settings version: expected version = 1")
            return
        }
        if (!value("", "editor").equals("") && !value("", "editor").equals("t")) {
            error("editor must be a table")
        }
        if (!value("", "keyboard").equals("") && !value("", "keyboard").equals("t")) {
            error("keyboard must be a table")
        }
        if (!value("", "project").equals("") && !value("", "project").equals("t")) {
            error("project must be a table")
        }
        if (value("", "keyboard").equals("")) { loadLegacy() }
        String reopen = value("project", "reopen_last")
        if (reopen.equals("btrue")) { reopenLast = true }
        else { if (!reopen.equals("") && !reopen.equals("bfalse")) { error("project.reopen_last must be a boolean") } }
        String last = value("project", "last_root")
        if (!last.equals("") && !last.equals("s")) {
            if (!last.startsWith("s/") || last.contains("\n") || last.length > 4097) {
                error("project.last_root must be an absolute folder path")
            } else { lastRoot = last.slice(1, last.length) }
        }
        String font = value("editor", "font_family")
        if (!font.equals("")) {
            if (!font.startsWith("s")) { error("editor.font_family must be a string") }
            else {
                String name = font.slice(1, font.length)
                String problem = fontError(name)
                if (problem.equals("")) { fontFamily = name } else { error(problem) }
            }
        }
        fontSize = integer("font_size", fontSize, 6, 72)
        tabWidth = integer("tab_width", tabWidth, 1, 16)
        insertSpaces = boolean("insert_spaces", insertSpaces)
        lineNumbers = boolean("line_numbers", lineNumbers)
        wrap = boolean("wrap", wrap)
        highlightLine = boolean("highlight_current_line", highlightLine)
        // Stage the complete map before checking conflicts, allowing swaps.
        int i = 0
        while (i < commands.length) {
            CommandBinding binding = commands[i] as CommandBinding
            String raw = value("keyboard", binding.id)
            if (!raw.equals("")) {
                if (!raw.startsWith("s")) { error(format("keyboard.{} must be a string", binding.id)) }
                else { binding.setTrigger(raw.slice(1, raw.length)) }
            }
            i = i + 1
        }
        i = 0
        while (i < commands.length) {
            CommandBinding binding = commands[i] as CommandBinding
            String problem = bindingError(binding, binding.trigger)
            if (!problem.equals("")) {
                binding.valid = false
                error(problem)
            }
            i = i + 1
        }
        String key = Gtk.Config().key(original, "keyboard", 0)
        i = 0
        while (!key.equals("")) {
            if (command(key) == null) { error(format("Unknown keyboard command: {}", key)) }
            i = i + 1
            key = Gtk.Config().key(original, "keyboard", i)
        }
    }

    void resetKeyboard() {
        int i = 0
        while (i < commands.length) {
            CommandBinding binding = commands[i] as CommandBinding
            binding.setTrigger(binding.defaultTrigger)
            i = i + 1
        }
    }

    String serialize() {
        String text = format("version = 1\n[editor]\nfont_family = {}\nfont_size = {}\ntab_width = {}\ninsert_spaces = {}\nline_numbers = {}\nwrap = {}\nhighlight_current_line = {}\n[keyboard]\n",
            Gtk.Config().quote(fontFamily), fontSize, tabWidth, insertSpaces, lineNumbers, wrap, highlightLine)
        int i = 0
        while (i < commands.length) {
            CommandBinding binding = commands[i] as CommandBinding
            text.append(format("{} = {}\n", binding.id, Gtk.Config().quote(binding.trigger)))
            i = i + 1
        }
        text.append(format("[project]\nreopen_last = {}\nlast_root = {}\n", reopenLast, Gtk.Config().quote(lastRoot)))
        return Gtk.Config().merge(original, text)
    }
}

class KeyboardPreference {
    KeyboardPreference _self()
    CommandBinding binding
    TweedSettings settings
    Gtk.Box row
    Gtk.Label name
    Gtk.Entry entry
    Gtk.Button recordButton
    Gtk.Button resetButton
    Gtk.Button disableButton
    Gtk.Label errorLabel
    callback<void()> applied
    callback<void()> prepareRecord
    int recording
    bool refreshing

    KeyboardPreference(TweedSettings model, CommandBinding command, callback<void()> changed,
                       callback<void()> prepare) {
        settings = model
        binding = command
        applied = changed
        prepareRecord = prepare
        row = Gtk.Box(Gtk.Box.VERTICAL, 2)
        Gtk.Box controls = Gtk.Box(Gtk.Box.HORIZONTAL, 4)
        name = Gtk.Label(binding.name)
        entry = Gtk.Entry(binding.trigger)
        recordButton = Gtk.Button("Record")
        resetButton = Gtk.Button("Reset")
        disableButton = Gtk.Button("Disable")
        errorLabel = Gtk.Label("")
        controls.append(name)
        controls.append(entry)
        controls.append(recordButton)
        controls.append(resetButton)
        controls.append(disableButton)
        row.append(controls)
        row.append(errorLabel)
        entry.onChanged(_self().changedTrigger)
        recordButton.onClicked(_self().record)
        resetButton.onClicked(_self().reset)
        disableButton.onClicked(_self().disable)
    }

    void changedTrigger(String text) {
        if (refreshing) { return }
        if (text.equals("")) {
            errorLabel.setText("Use Disable to remove this binding")
            return
        }
        String problem = settings.bindingError(binding, text)
        errorLabel.setText(problem)
        if (!problem.equals("")) { return }
        binding.setTrigger(text)
        applied()
    }
    void record() {
        prepareRecord()
        errorLabel.setText("Press shortcut; Escape cancels")
        recording = Gtk.Keyboard().record(entry, _self().recorded)
    }
    void recorded(String trigger) {
        cancelRecording()
        if (!trigger.equals("")) { setTrigger(trigger) }
    }
    void cancelRecording() {
        if (recording != 0) {
            Gtk.Keyboard().cancel(recording)
            recording = 0
            errorLabel.setText("")
        }
    }
    void reset() {
        cancelRecording()
        setTrigger(binding.defaultTrigger)
    }
    void disable() {
        cancelRecording()
        refreshing = true
        entry.setText("")
        refreshing = false
        binding.setTrigger("")
        errorLabel.setText("")
        applied()
    }
    void setTrigger(String trigger) {
        refreshing = true
        entry.setText(trigger)
        refreshing = false
        changedTrigger(trigger)
    }
    void refresh() {
        refreshing = true
        cancelRecording()
        entry.setText(binding.trigger)
        errorLabel.setText("")
        refreshing = false
    }
}

KeyboardPreference KeyboardPreference._self() from "simp_gtk_self"

class WorkspaceFile {
    String path
    int line
    int column
    WorkspaceFile(String file, int row, int col) {
        path = file
        line = row
        column = col
    }
}

// A Tweed project: shareable configuration in <root>/.tweed/project.toml and
// local session state in <root>/.tweed/workspace.toml. Metadata paths are
// always derived from the canonical root, never from persisted contents.
class TweedProject {
    String root
    String directory
    String configPath
    String workspacePath
    String name
    list excludes
    String original
    String base
    String workspaceOriginal
    String workspaceText
    String savingConfig
    String savingWorkspace
    String errors
    String workspaceErrors
    bool writable
    bool workspaceWritable
    bool hasFont
    String fontFamily
    bool hasSize
    int fontSize
    bool hasTabs
    int tabWidth
    bool hasSpaces
    bool insertSpaces
    bool hasNumbers
    bool lineNumbers
    bool hasWrap
    bool wrap
    bool hasHighlight
    bool highlightLine
    String active
    int explorerWidth
    int windowWidth
    int windowHeight
    list expanded
    list files
    String readError
    bool readMissing
    bool readContent

    TweedProject(String projectRoot) {
        root = projectRoot
        directory = System.FileSystem().join(root, ".tweed")
        configPath = System.FileSystem().join(directory, "project.toml")
        workspacePath = System.FileSystem().join(directory, "workspace.toml")
        name = System.FileSystem().basename(root)
        if (name.equals("") || name.length > 128) { name = "Project" }
        excludes = []
        original = ""
        base = ""
        workspaceOriginal = ""
        workspaceText = ""
        savingConfig = ""
        savingWorkspace = ""
        errors = ""
        workspaceErrors = ""
        writable = true
        workspaceWritable = true
        fontFamily = "monospace"
        fontSize = 12
        tabWidth = 4
        insertSpaces = true
        lineNumbers = true
        wrap = false
        highlightLine = false
        resetWorkspace()
        readError = ""
    }

    void resetWorkspace() {
        active = ""
        explorerWidth = -1
        windowWidth = -1
        windowHeight = -1
        expanded = []
        files = []
    }

    void error(String message) {
        if (!errors.equals("")) { errors.append("\n") }
        errors.append(message)
        writable = false
    }

    void workspaceError(String message) {
        if (!workspaceErrors.equals("")) { workspaceErrors.append("\n") }
        workspaceErrors.append(message)
        workspaceWritable = false
        resetWorkspace()
    }

    String prefix() {
        if (root.endsWith("/")) { return root }
        return format("{}/", root)
    }

    // Root-relative path, or "" when path is outside the root.
    String relative(String path) {
        String head = prefix()
        if (!path.startsWith(head) || path.length == head.length) { return "" }
        String rest = path.slice(head.length, path.length)
        if (!validRelative(rest)) { return "" }
        return rest
    }

    bool hasControl(String text) {
        return text.contains("\n") || text.contains("\r") || text.contains("\t")
    }

    bool validRelative(String path) {
        if (path.equals("") || path.length > 4096 || path.startsWith("/") || hasControl(path)) { return false }
        list parts = path.split("/")
        int i = 0
        while (i < parts.length) {
            String part = parts[i] as String
            if (part.equals("") || part.equals(".") || part.equals("..")) { return false }
            i = i + 1
        }
        return true
    }

    String nameError(String text) {
        if (text.trim().equals("") || text.length > 128 || hasControl(text)) {
            return "Project name must be 1-128 characters, without control characters"
        }
        return ""
    }

    String excludeError(String pattern) {
        if (pattern.trim().equals("") || pattern.length > 256 || hasControl(pattern)) {
            return "Exclusion patterns must be 1-256 characters, without control characters"
        }
        if (pattern.startsWith("/") || pattern.endsWith("/") || !validRelative(pattern)) {
            return format("Invalid exclusion pattern {}: use a name or root-relative path without leading/trailing /, ., or .. segments", pattern)
        }
        return ""
    }

    // Refuses symlinked or non-regular metadata so writes and deletes stay
    // inside root/.tweed.
    String metadataProblem() {
        if (!System.FileSystem().exists(directory)) { return "" }
        if (!System.FileSystem().isDir(directory) ||
            !System.FileSystem().absolutePath(directory).equals(directory)) {
            return format("{} must be a real directory, not a file or symbolic link", directory)
        }
        String problem = fileProblem(configPath)
        if (problem.equals("")) { problem = fileProblem(workspacePath) }
        return problem
    }

    String fileProblem(String path) {
        if (!System.FileSystem().exists(path)) { return "" }
        if (!System.FileSystem().isFile(path) ||
            !System.FileSystem().absolutePath(path).equals(path)) {
            return format("{} must be a regular file, not a symbolic link", path)
        }
        return ""
    }

    // readMissing: no file; readContent: bytes were read (readError may still
    // report malformed contents).
    String readMetadata(String path, int limit) {
        readError = ""
        readMissing = false
        readContent = false
        String presence = Gtk.Config().fileStatus(path)
        if (presence.equals("missing")) {
            readMissing = true
            return ""
        }
        if (presence.length > 0) {
            readError = format("Could not read {}: {}", path, presence)
            return ""
        }
        if (!System.FileSystem().isFile(path) || System.FileSystem().fileSize(path) > limit) {
            readError = format("{} must be a regular file no larger than {} KiB", path, limit / 1024)
            return ""
        }
        System.File file = System.File(path, "r")
        if (!file.isOpen()) {
            readError = format("Could not read {}: {}", path, System.System().lastError())
            return ""
        }
        String text = ""
        try { text = file.readAll() }
        except(Exception) as failure { readError = format("Could not read {}: {}", path, failure.message) }
        String lastError = System.System().lastError()
        file.close()
        if (readError.equals("") && !lastError.equals("")) {
            readError = format("Could not read {}: {}", path, lastError)
        }
        if (!readError.equals("")) { return "" }
        readContent = true
        if (!GtkSource.Content().isText(text)) {
            readError = format("Malformed {}: not UTF-8 text", path)
            return text
        }
        String malformed = Gtk.Config().validate(text)
        if (!malformed.equals("")) { readError = format("Malformed TOML in {}: {}", path, malformed) }
        return text
    }

    String value(String section, String key) { return Gtk.Config().value(base, section, key) }

    void table(String text, String key) {
        String kind = Gtk.Config().value(text, "", key)
        if (!kind.equals("") && !kind.equals("t")) { error(format("{} must be a table", key)) }
    }

    int integer(String key, int minimum, int maximum) {
        String raw = value("editor", key)
        if (raw.equals("")) { return -1 }
        if (raw.startsWith("i")) {
            int number = raw.slice(1, raw.length).toInt()
            if (number >= minimum && number <= maximum) { return number }
        }
        error(format("editor.{} must be an integer from {} to {}", key, minimum, maximum))
        return -1
    }

    // -1 inherit (absent or invalid), 0 false, 1 true.
    int boolean(String key) {
        String raw = value("editor", key)
        if (raw.equals("")) { return -1 }
        if (raw.equals("btrue")) { return 1 }
        if (raw.equals("bfalse")) { return 0 }
        error(format("editor.{} must be a boolean", key))
        return -1
    }

    // Returns "" when the project can be opened. Invalid individual values
    // keep it open with errors shown and its configuration unwritable.
    String load(TweedSettings settings) {
        String problem = metadataProblem()
        if (!problem.equals("")) { return problem }
        original = readMetadata(configPath, 65536)
        if (readMissing) { return format("No Tweed project in {} (missing .tweed/project.toml); use Project > New Project... to create one", root) }
        if (!readError.equals("")) { return readError }
        base = original
        if (!value("", "version").equals("i1")) {
            return format("Unsupported project version in {}: expected version = 1", configPath)
        }
        table(base, "project")
        table(base, "explorer")
        table(base, "editor")
        String raw = value("project", "name")
        if (!raw.equals("")) {
            if (!raw.startsWith("s")) { error("project.name must be a string") }
            else {
                String text = raw.slice(1, raw.length)
                String nameProblem = nameError(text)
                if (nameProblem.equals("")) { name = text } else { error(nameProblem) }
            }
        }
        raw = value("explorer", "exclude")
        if (!raw.equals("")) {
            if (!raw.equals("x")) { error("explorer.exclude must be an array of strings") }
            else {
                int i = 0
                String item = Gtk.Config().item(base, "explorer", "exclude", 0, "")
                while (!item.equals("")) {
                    if (!item.startsWith("s")) { error("explorer.exclude must be an array of strings") }
                    else {
                        String pattern = item.slice(1, item.length)
                        String patternProblem = excludeError(pattern)
                        if (patternProblem.equals("")) { excludes.append(pattern) } else { error(patternProblem) }
                    }
                    i = i + 1
                    item = Gtk.Config().item(base, "explorer", "exclude", i, "")
                }
            }
        }
        raw = value("editor", "font_family")
        if (!raw.equals("")) {
            if (!raw.startsWith("s")) { error("editor.font_family must be a string") }
            else {
                String font = raw.slice(1, raw.length)
                String fontProblem = settings.fontError(font)
                if (fontProblem.equals("")) {
                    hasFont = true
                    fontFamily = font
                } else { error(format("editor.font_family: {}", fontProblem)) }
            }
        }
        int number = integer("font_size", 6, 72)
        hasSize = number > 0
        if (hasSize) { fontSize = number }
        number = integer("tab_width", 1, 16)
        hasTabs = number > 0
        if (hasTabs) { tabWidth = number }
        number = boolean("insert_spaces")
        hasSpaces = number >= 0
        insertSpaces = number == 1
        number = boolean("line_numbers")
        hasNumbers = number >= 0
        lineNumbers = number == 1
        number = boolean("wrap")
        hasWrap = number >= 0
        wrap = number == 1
        number = boolean("highlight_current_line")
        hasHighlight = number >= 0
        highlightLine = number == 1
        loadWorkspace()
        return ""
    }

    void loadWorkspace() {
        workspaceOriginal = readMetadata(workspacePath, 1048576)
        if (readMissing) {
            workspaceOriginal = ""
            return
        }
        if (!readError.equals("")) {
            workspaceError(readError)
            return
        }
        String problem = parseWorkspace(workspaceOriginal)
        if (!problem.equals("")) { workspaceError(problem) }
    }

    String wsInteger(String text, String key, int minimum, int maximum) {
        String raw = Gtk.Config().value(text, "workspace", key)
        if (raw.equals("")) { return "" }
        if (raw.startsWith("i")) {
            int number = raw.slice(1, raw.length).toInt()
            if (number >= minimum && number <= maximum) { return format("{}", number) }
        }
        return format("workspace.{} must be an integer from {} to {}", key, minimum, maximum)
    }

    int wsNumber(String text, String key) {
        String raw = Gtk.Config().value(text, "workspace", key)
        if (raw.equals("")) { return -1 }
        return raw.slice(1, raw.length).toInt()
    }

    // Parses workspace TOML; returns "" or the first problem. Any problem
    // discards the whole workspace rather than restoring part of it.
    String parseWorkspace(String text) {
        resetWorkspace()
        if (!Gtk.Config().value(text, "", "version").equals("i1")) {
            return format("Unsupported workspace version in {}: expected version = 1", workspacePath)
        }
        String kind = Gtk.Config().value(text, "", "workspace")
        if (kind.equals("")) { return "" }
        if (!kind.equals("t")) { return "workspace must be a table" }
        String raw = Gtk.Config().value(text, "workspace", "active")
        if (!raw.equals("")) {
            if (!raw.startsWith("s") || !validRelative(raw.slice(1, raw.length))) {
                return "workspace.active must be a root-relative path"
            }
            active = raw.slice(1, raw.length)
        }
        // wsInteger yields digits when valid; messages always contain spaces.
        String problem = wsInteger(text, "explorer_width", 0, 5000)
        if (problem.contains(" ")) { return problem }
        problem = wsInteger(text, "window_width", 200, 10000)
        if (problem.contains(" ")) { return problem }
        problem = wsInteger(text, "window_height", 150, 10000)
        if (problem.contains(" ")) { return problem }
        explorerWidth = wsNumber(text, "explorer_width")
        windowWidth = wsNumber(text, "window_width")
        windowHeight = wsNumber(text, "window_height")
        raw = Gtk.Config().value(text, "workspace", "expanded")
        if (!raw.equals("") && !raw.equals("x")) { return "workspace.expanded must be an array of paths" }
        int i = 0
        String item = Gtk.Config().item(text, "workspace", "expanded", 0, "")
        while (!item.equals("")) {
            if (!item.startsWith("s") || !validRelative(item.slice(1, item.length))) {
                resetWorkspace()
                return "workspace.expanded must contain root-relative paths"
            }
            expanded.append(item.slice(1, item.length))
            i = i + 1
            item = Gtk.Config().item(text, "workspace", "expanded", i, "")
        }
        raw = Gtk.Config().value(text, "workspace", "files")
        if (!raw.equals("") && !raw.equals("x")) { return "workspace.files must be an array of tables" }
        i = 0
        item = Gtk.Config().item(text, "workspace", "files", 0, "")
        while (!item.equals("")) {
            String path = Gtk.Config().item(text, "workspace", "files", i, "path")
            String line = Gtk.Config().item(text, "workspace", "files", i, "line")
            String column = Gtk.Config().item(text, "workspace", "files", i, "column")
            if (!item.equals("t") || !path.startsWith("s") || !validRelative(path.slice(1, path.length)) ||
                !validPosition(line) || !validPosition(column)) {
                resetWorkspace()
                return "workspace.files entries must be tables with a root-relative path and positive line/column"
            }
            files.append(WorkspaceFile(path.slice(1, path.length), line.slice(1, line.length).toInt(),
                column.slice(1, column.length).toInt()))
            i = i + 1
            item = Gtk.Config().item(text, "workspace", "files", i, "")
        }
        return ""
    }

    bool validPosition(String raw) {
        if (!raw.startsWith("i")) { return false }
        int number = raw.slice(1, raw.length).toInt()
        return number >= 1 && number <= 100000000
    }

    String quotedList(list values) {
        String text = "["
        int i = 0
        while (i < values.length) {
            if (i > 0) { text.append(", ") }
            text.append(Gtk.Config().quote(values[i] as String))
            i = i + 1
        }
        text.append("]")
        return text
    }

    String excludeLines() {
        String text = ""
        int i = 0
        while (i < excludes.length) {
            if (i > 0) { text.append("\n") }
            text.append(excludes[i] as String)
            i = i + 1
        }
        return text
    }

    // Keeps unknown keys from the merge base; removed overrides fall back to
    // inheritance by deleting their keys.
    String serialize() {
        String text = base
        if (text.equals("")) { text = "version = 1\n" }
        if (!hasFont) { text = Gtk.Config().remove(text, "editor", "font_family") }
        if (!hasSize) { text = Gtk.Config().remove(text, "editor", "font_size") }
        if (!hasTabs) { text = Gtk.Config().remove(text, "editor", "tab_width") }
        if (!hasSpaces) { text = Gtk.Config().remove(text, "editor", "insert_spaces") }
        if (!hasNumbers) { text = Gtk.Config().remove(text, "editor", "line_numbers") }
        if (!hasWrap) { text = Gtk.Config().remove(text, "editor", "wrap") }
        if (!hasHighlight) { text = Gtk.Config().remove(text, "editor", "highlight_current_line") }
        String updates = format("version = 1\n[project]\nname = {}\n[explorer]\nexclude = {}\n",
            Gtk.Config().quote(name), quotedList(excludes))
        String editor = ""
        if (hasFont) { editor.append(format("font_family = {}\n", Gtk.Config().quote(fontFamily))) }
        if (hasSize) { editor.append(format("font_size = {}\n", fontSize)) }
        if (hasTabs) { editor.append(format("tab_width = {}\n", tabWidth)) }
        if (hasSpaces) { editor.append(format("insert_spaces = {}\n", insertSpaces)) }
        if (hasNumbers) { editor.append(format("line_numbers = {}\n", lineNumbers)) }
        if (hasWrap) { editor.append(format("wrap = {}\n", wrap)) }
        if (hasHighlight) { editor.append(format("highlight_current_line = {}\n", highlightLine)) }
        if (!editor.equals("")) {
            updates.append("[editor]\n")
            updates.append(editor)
        }
        return Gtk.Config().merge(text, updates)
    }

    // Copies configuration (including unknown keys) for Save As.
    void copyConfiguration(TweedProject source) {
        base = source.base
        name = source.name
        excludes = []
        int i = 0
        while (i < source.excludes.length) {
            excludes.append(source.excludes[i] as String)
            i = i + 1
        }
        hasFont = source.hasFont
        fontFamily = source.fontFamily
        hasSize = source.hasSize
        fontSize = source.fontSize
        hasTabs = source.hasTabs
        tabWidth = source.tabWidth
        hasSpaces = source.hasSpaces
        insertSpaces = source.insertSpaces
        hasNumbers = source.hasNumbers
        lineNumbers = source.lineNumbers
        hasWrap = source.hasWrap
        wrap = source.wrap
        hasHighlight = source.hasHighlight
        highlightLine = source.highlightLine
    }

    String overrideSummary() {
        list names = []
        if (hasFont) { names.append("font family") }
        if (hasSize) { names.append("font size") }
        if (hasTabs) { names.append("tab width") }
        if (hasSpaces) { names.append("insert spaces") }
        if (hasNumbers) { names.append("line numbers") }
        if (hasWrap) { names.append("wrap") }
        if (hasHighlight) { names.append("highlight current line") }
        String text = ""
        int i = 0
        while (i < names.length) {
            if (i > 0) { text.append(", ") }
            text.append(names[i] as String)
            i = i + 1
        }
        return text
    }
}

class OverrideRow {
    OverrideRow _self()
    String key
    bool boolean
    Gtk.Box row
    Gtk.CheckButton override
    Gtk.Entry entry
    Gtk.CheckButton value

    OverrideRow(String settingKey, String label, bool flag) {
        key = settingKey
        boolean = flag
        row = Gtk.Box(Gtk.Box.HORIZONTAL, 6)
        override = Gtk.CheckButton(format("Override {}", label))
        row.append(override)
        if (boolean) {
            value = Gtk.CheckButton("Enabled")
            row.append(value)
        } else {
            entry = Gtk.Entry("")
            entry.setHExpand(true)
            row.append(entry)
        }
        override.onToggled(_self().toggled)
    }

    void toggled(bool active) {
        if (boolean) { value.setSensitive(active) } else { entry.setSensitive(active) }
    }

    void show(bool overridden, String text, bool flag) {
        override.setActive(overridden)
        if (boolean) { value.setActive(flag) } else { entry.setText(text) }
        toggled(overridden)
    }
}
