        layout.append(workspace)
        notebook.onPageChanged(pageChangedAction)
        closeChoices = Gtk.Box(Gtk.Box.HORIZONTAL, 4)
        closeSaveButton = Gtk.Button("Save")
        closeDiscardButton = Gtk.Button("Discard")
        closeCancelButton = Gtk.Button("Cancel")
        closeChoices.append(closeSaveButton)
        closeChoices.append(closeDiscardButton)
        closeChoices.append(closeCancelButton)
        layout.append(closeChoices)
        closeChoices.setVisible(false)
        confirmChoices = Gtk.Box(Gtk.Box.HORIZONTAL, 4)
        confirmLabel = Gtk.Label("")
        confirmButton = Gtk.Button("Confirm")
        confirmCancelButton = Gtk.Button("Cancel")
        confirmChoices.append(confirmLabel)
        confirmChoices.append(confirmButton)
        confirmChoices.append(confirmCancelButton)
        confirmButton.onClicked(_self().acceptConfirm)
        confirmCancelButton.onClicked(_self().cancelConfirm)
        layout.append(confirmChoices)
        confirmChoices.setVisible(false)
        status = Gtk.Label("Ready")
        layout.append(status)
        findButton.onClicked(findAction)
        replaceButton.onClicked(replaceAction)
        replaceAllButton.onClicked(replaceAllAction)
        searchWindow.onCloseRequest(searchCloseAction)
        closeSaveButton.onClicked(closeSaveAction)
        closeDiscardButton.onClicked(closeDiscardAction)
        closeCancelButton.onClicked(closeCancelAction)
        window.onCloseRequest(closeAction)

        System.Process process = System.Process()
        bool explicitRequest = false
        int index = 1
        while (index < process.argc()) {
            String argument = process.arg(index)
            if (!argument.equals("--test")) { explicitRequest = true }
            if (!argument.equals("--test") && !argument.contains("://") && System.FileSystem().isDir(argument)) {
                openRootArgument(argument)
            } else { openFile(argument) }
            index = index + 1
        }
        // Explicit files or folders on the command line take precedence over reopening.
        if (!explicitRequest && settings.reopenLast && !settings.lastRoot.equals("")) {
            TweedProject last = loadProject(settings.lastRoot, "Could not reopen last project")
            if (last != null) { activateProject(last, true) }
        }
        if (notebook.pageCount() == 0) {
            newDocument()
        }
        window.present()
        presented = true
        if (!settings.errors.equals("")) {
            Gtk.AlertDialog().show(window, "Settings errors", format("{}\n{}\nAutomatic saving is disabled; repair the file and restart.", settings.path, settings.errors))
        }
        if (process.argc() > 1 && process.arg(1).equals("--test")) {
            Gtk.Application().post(testAction)
        }
    }

    callback<void()> commandAction(String command) {
        if (command.equals("save")) { return saveAction }
        if (command.equals("save-as")) { return saveAsAction }
        if (command.equals("open")) { return openAction }
        if (command.equals("new")) { return newAction }
        if (command.equals("close")) { return closeTabAction }
        if (command.equals("quit")) { return quitAction }
        if (command.equals("find")) { return showFindAction }
        if (command.equals("replace")) { return showReplaceAction }
        if (command.equals("undo")) { return undoAction }
        if (command.equals("redo")) { return redoAction }
        if (command.equals("cut")) { return cutAction }
        if (command.equals("copy")) { return copyAction }
        if (command.equals("paste")) { return pasteAction }
        if (command.equals("select-all")) { return selectAllAction }
        if (command.equals("preferences")) { return preferencesAction }
        if (command.equals("project-new")) { return _self().newProject }
        if (command.equals("project-open")) { return _self().openProject }
        if (command.equals("project-save")) { return _self().saveProject }
        if (command.equals("project-save-as")) { return _self().saveProjectAs }
        if (command.equals("project-delete")) { return _self().deleteProject }
        if (command.equals("project-configure")) { return _self().showConfigure }
        if (command.equals("about")) { return _self().showAbout }
        return null
    }

    void configureShortcuts(EditorDocument document) {
        applyDocumentSettings(document)
        document.view.onChanged(changedAction)
        document.view.onCursorMoved(cursorAction)
    }

    // Precedence: active project override, then user preference, then default.
    void applyDocumentSettings(EditorDocument document) {
        String font = settings.fontFamily
        int size = settings.fontSize
        int tabs = settings.tabWidth
        bool spaces = settings.insertSpaces
        bool numbers = settings.lineNumbers
        bool wrapLines = settings.wrap
        bool highlight = settings.highlightLine
        TweedProject current = activeProject
        if (current != null) {
            if (current.hasFont) { font = current.fontFamily }
            if (current.hasSize) { size = current.fontSize }
            if (current.hasTabs) { tabs = current.tabWidth }
            if (current.hasSpaces) { spaces = current.insertSpaces }
            if (current.hasNumbers) { numbers = current.lineNumbers }
            if (current.hasWrap) { wrapLines = current.wrap }
            if (current.hasHighlight) { highlight = current.highlightLine }
        }
        document.view.configure(font, size, tabs, spaces, numbers, wrapLines, highlight)
        if (document.shortcutRevision == settings.shortcutRevision) { return }
        document.shortcutRevision = settings.shortcutRevision
        document.view.clearShortcuts()
        document.shortcuts = []
        document.shortcutConflict = settings.legacyConflict
        int i = 0
        while (i < settings.commands.length) {
            CommandBinding binding = settings.commands[i] as CommandBinding
            if (binding.trigger.length > 0 && binding.valid) {
                if (document.view.bindShortcut(binding.trigger, binding.action)) {
                    document.shortcuts.append(binding.trigger)
                } else {
                    status.setText(format("Invalid shortcut trigger: {}", binding.trigger))
                }
            }
            i = i + 1
        }
    }

    void createPreferences() {
        preferencesWindow = Gtk.TransientWindow("Tweed Preferences")
        preferencesWindow.setTransientFor(window)
        preferencesWindow.setDefaultSize(850, 600)
        Gtk.Box root = Gtk.Box(Gtk.Box.VERTICAL, 8)
        Gtk.Box content = Gtk.Box(Gtk.Box.HORIZONTAL, 12)
        Gtk.Box categories = Gtk.Box(Gtk.Box.VERTICAL, 6)
        Gtk.Button editorCategory = Gtk.Button("Editor")
        Gtk.Button keyboardCategory = Gtk.Button("Keyboard")
        categories.append(editorCategory)
        categories.append(keyboardCategory)
        editorCategory.onClicked(_self().showEditorPreferences)
        keyboardCategory.onClicked(_self().showKeyboardPreferences)
        content.append(categories)
        Gtk.Box pages = Gtk.Box(Gtk.Box.VERTICAL, 8)
        pages.setHExpand(true)
        pages.setVExpand(true)
        content.append(pages)
        editorPreferences = Gtk.Box(Gtk.Box.VERTICAL, 6)
        editorPreferences.append(Gtk.Label("Editor (global settings)"))
        projectNote = Gtk.Label("")
        editorPreferences.append(projectNote)
        fontEntry = preferenceEntry(editorPreferences, "Monospace font family", settings.fontFamily)
        sizeEntry = preferenceEntry(editorPreferences, "Font size (6-72 pt)", format("{}", settings.fontSize))
        tabsEntry = preferenceEntry(editorPreferences, "Tab width (1-16 columns)", format("{}", settings.tabWidth))
        spacesCheck = preferenceCheck("Insert spaces instead of tabs", settings.insertSpaces)
        numbersCheck = preferenceCheck("Show line numbers", settings.lineNumbers)
        wrapCheck = preferenceCheck("Wrap long lines", settings.wrap)
        highlightCheck = preferenceCheck("Highlight current line", settings.highlightLine)
        fontEntry.onChanged(_self().editorSettingChanged)
        sizeEntry.onChanged(_self().editorSettingChanged)
        tabsEntry.onChanged(_self().editorSettingChanged)
        Gtk.Button editorReset = Gtk.Button("Reset Editor to Defaults")
        editorReset.onClicked(_self().resetEditorPreferences)
        editorPreferences.append(editorReset)
        pages.append(editorPreferences)
        keyboardPreferences = Gtk.Box(Gtk.Box.VERTICAL, 6)
        commandSearch = Gtk.Entry("")
        keyboardPreferences.append(Gtk.Label("Search commands; empty binding disables a command"))
        keyboardPreferences.append(commandSearch)
        commandSearch.onChanged(_self().filterCommands)
        Gtk.ScrolledWindow scroll = Gtk.ScrolledWindow()
        scroll.setVExpand(true)
        keyboardRowsBox = Gtk.Box(Gtk.Box.VERTICAL, 4)
        scroll.setChild(keyboardRowsBox)
        keyboardRows = []
        keyboardPreferences.append(scroll)
        Gtk.Button keyboardReset = Gtk.Button("Reset Keyboard to Defaults")
        keyboardReset.onClicked(_self().resetKeyboardPreferences)
        keyboardPreferences.append(keyboardReset)
        pages.append(keyboardPreferences)
        keyboardPreferences.setVisible(false)
        root.append(content)
        reopenCheck = Gtk.CheckButton("Reopen last project on startup")
        reopenCheck.setActive(settings.reopenLast)
        reopenCheck.onToggled(_self().reopenChanged)
        root.append(reopenCheck)
        preferencesMessage = Gtk.Label(settings.errors)
        root.append(preferencesMessage)
        root.append(Gtk.Label(format("Automatically saved to {}", settings.path)))
        resetChoices = Gtk.Box(Gtk.Box.HORIZONTAL, 6)
        resetChoices.append(Gtk.Label("Reset this section?"))
        confirmResetButton = Gtk.Button("Confirm Reset")
        cancelResetButton = Gtk.Button("Cancel")
        confirmResetButton.onClicked(_self().confirmPreferencesReset)
        cancelResetButton.onClicked(_self().cancelPreferencesReset)
        resetChoices.append(confirmResetButton)
        resetChoices.append(cancelResetButton)
        root.append(resetChoices)
        resetChoices.setVisible(false)
        preferencesWindow.setChild(root)
        preferencesWindow.onCloseRequest(_self().hidePreferences)
        preferencesWindow.setVisible(false)
    }

    Gtk.Entry preferenceEntry(Gtk.Box page, String label, String text) {
        Gtk.Box row = Gtk.Box(Gtk.Box.HORIZONTAL, 6)
        row.append(Gtk.Label(label))
        Gtk.Entry entry = Gtk.Entry(text)
        entry.setHExpand(true)
        row.append(entry)
        page.append(row)
        return entry
    }

    Gtk.CheckButton preferenceCheck(String label, bool active) {
        Gtk.CheckButton check = Gtk.CheckButton(label)
        check.setActive(active)
        check.onToggled(_self().editorCheckChanged)
        editorPreferences.append(check)
        return check
    }

    void showPreferences() {
        if (commandsBlocked()) { return }
        if (preferencesWindow == null) { createPreferences() }
        refreshProjectNote()
        preferencesWindow.present()
    }
    void refreshProjectNote() {
        if (projectNote == null) { return }
        String overrides = ""
        if (activeProject != null) { overrides = activeProject.overrideSummary() }
        if (overrides.equals("")) { projectNote.setText("") }
        else { projectNote.setText(format("Project {} overrides: {} (Project > Configure Project...)", activeProject.name, overrides)) }
    }
    void reopenChanged(bool active) {
        if (refreshingPreferences) { return }
        settings.reopenLast = active
        settings.lastRoot = ""
        if (active && activeProject != null) { settings.lastRoot = activeProject.root }
        settingsChanged()
    }
    void persistSettings() {
        if (preferencesWindow == null) { createPreferences() }
        settingsChanged()
    }
    // The user config stores only the root locator; workspace state stays in .tweed.
    void rememberProject(String root) {
        if (settings.reopenLast && !settings.lastRoot.equals(root)) {
            settings.lastRoot = root
            persistSettings()
        }
    }
    void forgetProject(String root) {
        if (settings.lastRoot.equals(root)) {
            settings.lastRoot = ""
            persistSettings()
        }
    }
    bool hidePreferences() {
        if (preferencesWindow == null || preferencesWindow.disposed()) { return true }
        stopRecording()
        cancelPreferencesReset()
        preferencesWindow.setVisible(false)
        return true
    }
    void stopRecording() {
        int i = 0
        while (i < keyboardRows.length) {
            (keyboardRows[i] as KeyboardPreference).cancelRecording()
            i = i + 1
        }
    }
    void showEditorPreferences() {
        hidePreferences()
        editorPreferences.setVisible(true)
        keyboardPreferences.setVisible(false)
        preferencesWindow.present()
    }
    void showKeyboardPreferences() {
        hidePreferences()
        if (keyboardRows.length == 0) {
            int i = 0
            while (i < settings.commands.length) {
                KeyboardPreference row = KeyboardPreference(settings, settings.commands[i] as CommandBinding,
                    _self().keyboardSettingsChanged, _self().stopRecording)
                keyboardRows.append(row)
                keyboardRowsBox.append(row.row)
                i = i + 1
            }
        }
        editorPreferences.setVisible(false)
        keyboardPreferences.setVisible(true)
        preferencesWindow.present()
    }
    void filterCommands(String query) {
        int i = 0
        while (i < keyboardRows.length) {
            KeyboardPreference row = keyboardRows[i] as KeyboardPreference
            row.row.setVisible(row.binding.name.toLower().contains(query.toLower()) ||
                               row.binding.id.contains(query.toLower()))
            i = i + 1
        }
    }
    int preferenceNumber(String text, int minimum, int maximum) {
        if (text.length == 0 || text.length > 2) { return -1 }
        int i = 0
        while (i < text.length) {
            if (!"0123456789".contains(text.slice(i, i + 1))) { return -1 }
            i = i + 1
        }
        int number = text.toInt()
        if (number < minimum || number > maximum) { return -1 }
        return number
    }
    void editorCheckChanged(bool active) { editorSettingChanged("") }
    void editorSettingChanged(String text) {
        if (refreshingPreferences) { return }
        String problem = settings.fontError(fontEntry.text())
        int size = preferenceNumber(sizeEntry.text(), 6, 72)
        int tabs = preferenceNumber(tabsEntry.text(), 1, 16)
        if (size < 0) { problem = "Font size must be an integer from 6 to 72" }
        if (tabs < 0) { problem = "Tab width must be an integer from 1 to 16" }
        if (!problem.equals("")) {
            preferencesMessage.setText(problem)
            return
        }
        settings.fontFamily = fontEntry.text()
        settings.fontSize = size
        settings.tabWidth = tabs
        settings.insertSpaces = spacesCheck.active()
        settings.lineNumbers = numbersCheck.active()
        settings.wrap = wrapCheck.active()
        settings.highlightLine = highlightCheck.active()
        settingsChanged()
    }
    void resetEditorPreferences() {
        resetSection = "Editor"
        resetChoices.setVisible(true)
    }
    void resetKeyboardPreferences() {
        resetSection = "Keyboard"
        resetChoices.setVisible(true)
    }
    void cancelPreferencesReset() {
        resetSection = ""
        resetChoices.setVisible(false)
    }
    void confirmPreferencesReset() {
        if (resetSection.equals("Editor")) {
            settings.resetEditor()
            refreshingPreferences = true
            fontEntry.setText(settings.fontFamily)
            sizeEntry.setText(format("{}", settings.fontSize))
            tabsEntry.setText(format("{}", settings.tabWidth))
            spacesCheck.setActive(settings.insertSpaces)
            numbersCheck.setActive(settings.lineNumbers)
            wrapCheck.setActive(settings.wrap)
            highlightCheck.setActive(settings.highlightLine)
            refreshingPreferences = false
        }
        if (resetSection.equals("Keyboard")) {
            settings.resetKeyboard()
            settings.shortcutRevision = settings.shortcutRevision + 1
            int i = 0
            while (i < keyboardRows.length) {
                (keyboardRows[i] as KeyboardPreference).refresh()
                i = i + 1
            }
        }
        cancelPreferencesReset()
        settingsChanged()
    }
    void settingsChanged() {
        int i = 0
        while (i < documents.length) {
            applyDocumentSettings(documents[i] as EditorDocument)
            i = i + 1
        }
        if (!settings.writable) {
            preferencesMessage.setText(format("{}\nChanges apply for this session only; saving disabled.", settings.errors))
            return
        }
        if (savePending) {
            saveAgain = true
            return
        }
        saveSettings()
    }
    void keyboardSettingsChanged() {
        settings.shortcutRevision = settings.shortcutRevision + 1
        settingsChanged()
    }
    bool saveSettings() {
        String text = settings.serialize()
        if (text.equals(persistedText)) { return true }
        String directory = System.FileSystem().dirname(settings.path)
        if (!makeSettingsDirectory(directory)) {
            preferencesMessage.setText(format("Settings save failed: {}", System.System().lastError()))
            return false
        }
        // Refuse to overwrite a file edited externally since the last load/save.
        if (System.FileSystem().exists(settings.path)) {
            if (!System.FileSystem().isFile(settings.path) ||
                System.FileSystem().fileSize(settings.path) > 65536) {
                preferencesMessage.setText("Settings save failed: current settings must be a regular file no larger than 64 KiB")
                return false
            }
            System.File file = System.File(settings.path, "r")
            if (!file.isOpen()) {
                preferencesMessage.setText("Settings save failed: cannot read current settings")
                return false
            }
            String disk = ""
            try { disk = file.readAll() }
            except(Exception) as failure {
                file.close()
                preferencesMessage.setText(format("Settings save failed: {}", failure.message))
                return false
            }
            String readError = System.System().lastError()
            file.close()
            if (!readError.equals("") || !disk.equals(persistedText)) {
                preferencesMessage.setText("Settings changed on disk; restart before saving preferences")
                return false
            }
        } else {
            if (!persistedText.equals("")) {
                preferencesMessage.setText("Settings removed on disk; restart before saving preferences")
                return false
            }
        }
        savingText = text
        savePending = true
        preferencesMessage.setText("Saving settings...")
        Gtk.Config().save(settings.path, text, persistedText, _self().settingsSaved)
        return true
    }
    bool makeSettingsDirectory(String directory) {
        if (System.FileSystem().isDir(directory)) { return true }
        String parent = System.FileSystem().dirname(directory)
        if (parent.equals(directory) || directory.equals("")) { return false }
        if (!makeSettingsDirectory(parent)) { return false }
        return System.FileSystem().mkdir(directory)
    }
    void settingsSaved(String error) {
        savePending = false
        if (!error.equals("")) {
            preferencesMessage.setText(format("Settings save failed: {}", error))
            saveAgain = false
            closeAfterSave = false
            preferencesWindow.present()
            return
        }
        persistedText = savingText
        settings.original = savingText
        preferencesMessage.setText("Settings saved")
        if (saveAgain) {
            saveAgain = false
            if (!saveSettings()) {
                closeAfterSave = false
                preferencesWindow.present()
                return
            }
        }
        if (closeAfterSave && !savePending && projectSaves == 0 && !window.disposed()) {
            closeAfterSave = false
            window.close()
        }
    }

    // ---- Projects -------------------------------------------------------

    String version() {
        // Keep in sync with project(simp VERSION ...) in CMakeLists.txt.
        return "0.0.1"
    }

    void projectFailure(String title, String detail) {
        status.setText(format("{}: {}", title, detail))
        Gtk.AlertDialog().show(window, title, detail)
    }

    String canonicalFolder(String path, String title) {
        if (path.contains("://")) {
            projectFailure(title, "only local filesystem paths are supported")
            return ""
        }
        String requested = path
        if (!requested.startsWith("/")) {
            requested = System.FileSystem().join(System.FileSystem().getCwd(), requested)
        }
        String canonical = System.FileSystem().absolutePath(requested)
        if (canonical.equals("") || !System.FileSystem().isDir(canonical)) {
            projectFailure(title, format("{} is not an accessible folder", path))
            return ""
        }
        return canonical
    }

    TweedProject loadProject(String path, String title) {
        String root = canonicalFolder(path, title)
        if (root.equals("")) { return null }
        // Choosing the .tweed folder itself selects its project root.
        if (System.FileSystem().basename(root).equals(".tweed") &&
            System.FileSystem().isFile(System.FileSystem().join(root, "project.toml"))) {
            root = System.FileSystem().dirname(root)
        }
        TweedProject candidate = TweedProject(root)
        String problem = candidate.load(settings)
        if (!problem.equals("")) {
            projectFailure(title, problem)
            return null
        }
        return candidate
    }

    void openRootArgument(String path) {
        if (activeProject != null || !project.rootPath.equals("")) {
            status.setText(format("Ignored extra folder argument: {}", path))
            return
        }
        String root = canonicalFolder(path, "Could not open folder")
        if (root.equals("")) { return }
        if (System.FileSystem().isFile(System.FileSystem().join(root, ".tweed/project.toml"))) {
            TweedProject candidate = loadProject(root, "Could not open project")
            if (candidate != null) { activateProject(candidate, true) }
            return
        }
        project.setRoot(root)
    }

    void chooseProjectFolder(String purpose) {
        if (commandsBlocked()) { return }
        chooserPurpose = purpose
        String initialPath = project.rootPath
        if (purpose.equals("project-save-as") && activeProject != null) {
            initialPath = System.FileSystem().dirname(activeProject.root)
        }
        fileDialog = Gtk.FileDialog(window, initialPath, _self().projectFolderChosen)
        updateMenu()
    }

    void newProject() { chooseProjectFolder("project-new") }
    void openProject() { chooseProjectFolder("project-open") }
    void saveProjectAs() {
        if (activeProject == null) {
            status.setText("No project is open")
            return
        }
        chooseProjectFolder("project-save-as")
    }

    void projectFolderChosen(String path) {
        fileDialog = null
        String purpose = chooserPurpose
        chooserPurpose = ""
        updateMenu()
        if (purpose.equals("")) { return }
        if (path.equals("")) {
            status.setText("Cancelled")
            return
        }
        if (purpose.equals("project-open")) { openProjectAt(path) }
        if (purpose.equals("project-new")) { prepareNewProject(path, false) }
        if (purpose.equals("project-save-as")) { prepareNewProject(path, true) }
    }

    void openProjectAt(String path) {
        TweedProject candidate = loadProject(path, "Could not open project")
        if (candidate == null) { return }
        if (activeProject != null && activeProject.root.equals(candidate.root)) {
            status.setText(format("Project already open: {}", candidate.root))
            return
        }
        nextProject = candidate
        beginSwitch("open")
    }

    // New and Save As create metadata for a chosen root; source files are never touched.
    void prepareNewProject(String path, bool copy) {
        String title = "Could not create project"
        if (copy) { title = "Could not save project as" }
        String root = canonicalFolder(path, title)
        if (root.equals("")) { return }
        if (copy && (activeProject == null || activeProject.root.equals(root))) {
            projectFailure(title, "Choose a different folder from the current project root")
            return
        }
        TweedProject candidate = TweedProject(root)
        String problem = candidate.metadataProblem()
        if (!problem.equals("")) {
            projectFailure(title, problem)
            return
        }
        // Existing on-disk text becomes the expected original, guarding replacement.
        candidate.original = candidate.readMetadata(candidate.configPath, 65536)
        bool exists = !candidate.readMissing
        if (!candidate.readError.equals("") && !candidate.readContent) {
            projectFailure(title, candidate.readError)
            return
        }
        candidate.workspaceOriginal = candidate.readMetadata(candidate.workspacePath, 1048576)
        exists = exists || !candidate.readMissing
        if (!candidate.readError.equals("") && !candidate.readContent) {
            projectFailure(title, candidate.readError)
            return
        }
        if (copy) {
            candidate.copyConfiguration(activeProject)
            candidate.workspaceText = captureWorkspace(activeProject.root, root)
        } else {
            candidate.workspaceText = captureWorkspace(root, root)
        }
        nextProject = candidate
        String op = "new"
        if (copy) { op = "save-as" }
        if (exists) {
            askConfirm(format("replace-{}", op), format("{} already has Tweed project metadata. Replace .tweed/project.toml and .tweed/workspace.toml?", root), "Replace Metadata")
            return
        }
        startNewProject(op)
    }

    void startNewProject(String op) {
        // Save As leaves the original project's files untouched.
        if (op.equals("save-as")) {
            writeProject(nextProject, true, true, "activate")
            return
        }
        beginSwitch("new")
    }

    void saveProject() {
        if (commandsBlocked() || activeProject == null) { return }
        activeProject.workspaceText = captureWorkspace(activeProject.root, activeProject.root)
        status.setText("Saving project...")
        writeProject(activeProject, true, true, "save")
    }

    void deleteProject() {
        if (commandsBlocked() || activeProject == null) { return }
        askConfirm("delete", format("Delete Tweed project metadata for {}? Only .tweed/project.toml and .tweed/workspace.toml are removed; source files are kept.", activeProject.root), "Delete Metadata")
    }

    void deleteProjectMetadata() {
        TweedProject target = activeProject
        if (target == null) { return }
        String problem = target.metadataProblem()
        if (!problem.equals("")) {
            projectFailure("Could not delete project metadata", problem)
            return
        }
        String failures = ""
        if (System.FileSystem().exists(target.workspacePath)) {
            if (System.FileSystem().remove(target.workspacePath)) { target.workspaceOriginal = "" }
            else { failures.append(format("{}: {}\n", target.workspacePath, System.System().lastError())) }
        }
        if (System.FileSystem().exists(target.configPath) && !System.FileSystem().remove(target.configPath)) {
            failures.append(format("{}: {}\n", target.configPath, System.System().lastError()))
        }
        if (!failures.equals("")) {
            projectFailure("Could not delete project metadata", failures)
            return
        }
        // Succeeds only if .tweed is now empty; unknown files are preserved.
        System.FileSystem().rmdir(target.directory)
        detachProject()
        project.setRoot(target.root)
        forgetProject(target.root)
        status.setText(format("Deleted project metadata; {} remains open as a folder", target.root))
    }

    void beginSwitch(String op) {
        if (activeProject != null) {
            activeProject.workspaceText = captureWorkspace(activeProject.root, activeProject.root)
        }
        if (op.equals("open") && firstModifiedDocument() != null) {
            switchOp = op
            pendingCloseAll = true
            pendingCloseDocument = null
            closeChoices.setVisible(true)
            status.setText("Unsaved changes: Save, Discard, or Cancel opening the project")
            updateMenu()
            return
        }
        continueSwitch(op)
    }

    void continueSwitch(String op) {
        switchOp = ""
        bool sameRoot = false
        if (activeProject != null && nextProject != null) { sameRoot = activeProject.root.equals(nextProject.root) }
        if (activeProject != null && !sameRoot) {
            writeProject(activeProject, false, true, op)
            return
        }
        performProjectOp(op)
    }

    // Starts guarded asynchronous writes; op runs once all writes finish.
    void writeProject(TweedProject target, bool config, bool workspaceState, String op) {
        projectOp = op
        projectSaveErrors = ""
        savingProject = target
        bool explicit = op.equals("save") || op.equals("activate") || op.equals("configure")
        String problem = target.metadataProblem()
        if (!config && !workspaceState) { problem = "" }
        String configText = ""
        if (config) {
            if (!target.writable) {
                problem = format("{} has errors; repair it and reopen the project before saving:\n{}", target.configPath, target.errors)
            } else { configText = target.serialize() }
        }
        bool writeWorkspace = workspaceState && !target.workspaceText.equals(target.workspaceOriginal)
        if (workspaceState && !target.workspaceWritable) {
            writeWorkspace = false
            if (explicit && problem.equals("")) {
                problem = format("{} could not be loaded; repair or remove .tweed/workspace.toml and reopen the project:\n{}", target.workspacePath, target.workspaceErrors)
            }
        }
        bool writeConfig = config && !configText.equals(target.original)
        if (problem.equals("") && (writeConfig || writeWorkspace) && !System.FileSystem().isDir(target.directory)) {
            if (!System.FileSystem().mkdir(target.directory)) {
                problem = format("Could not create {}: {}", target.directory, System.System().lastError())
            } else { problem = target.metadataProblem() }
        }
        if (!problem.equals("")) {
            projectSaveErrors = problem
            finishProjectSave()
            return
        }
        if (writeConfig) {
            target.savingConfig = configText
            projectSaves = projectSaves + 1
            Gtk.Config().save(target.configPath, configText, target.original, _self().projectConfigSaved)
        }
        if (writeWorkspace) {
            target.savingWorkspace = target.workspaceText
            projectSaves = projectSaves + 1
            Gtk.Config().save(target.workspacePath, target.workspaceText, target.workspaceOriginal, _self().projectWorkspaceSaved)
        }
        updateMenu()
        if (projectSaves == 0) { finishProjectSave() }
    }

    String projectSaveMessage(String path, String error) {
        if (error.contains("changed on disk")) {
            return format("{} changed on disk since it was loaded; reopen the project before saving", path)
        }
        return format("{}: {}", path, error)
    }

    void addProjectSaveError(String message) {
        if (!projectSaveErrors.equals("")) { projectSaveErrors.append("\n") }
        projectSaveErrors.append(message)
    }

    void projectConfigSaved(String error) {
        projectSaves = projectSaves - 1
        if (error.equals("")) {
            savingProject.original = savingProject.savingConfig
            savingProject.base = savingProject.savingConfig
        } else { addProjectSaveError(projectSaveMessage(savingProject.configPath, error)) }
        if (projectSaves == 0) { finishProjectSave() }
    }

    void projectWorkspaceSaved(String error) {
        projectSaves = projectSaves - 1
        if (error.equals("")) { savingProject.workspaceOriginal = savingProject.savingWorkspace }
        else { addProjectSaveError(projectSaveMessage(savingProject.workspacePath, error)) }
        if (projectSaves == 0) { finishProjectSave() }
    }

    void finishProjectSave() {
        String op = projectOp
        String errors = projectSaveErrors
        projectOp = ""
        projectSaveErrors = ""
        savingProject = null
        if (window.disposed()) { return }
        updateMenu()
        if (errors.equals("")) { performProjectOp(op) } else { projectSaveFailed(op, errors) }
        if (closeAfterSave && !savePending && projectSaves == 0 && confirmOp.equals("") && !window.disposed()) {
            closeAfterSave = false
            window.close()
        }
    }

    void projectSaveFailed(String op, String errors) {
        closeAfterSave = false
        if (op.equals("save") || op.equals("configure")) {
            if (op.equals("configure") && configureMessage != null) { configureMessage.setText(format("Save failed: {}", errors)) }
            projectFailure("Project save failed", errors)
            return
        }
        if (op.equals("activate")) {
            nextProject = null
            projectFailure("Could not write project metadata", errors)
            return
        }
        String accept = "Continue Without Saving"
        if (op.equals("quit")) { accept = "Quit Without Saving" }
        askConfirm(format("continue-{}", op), format("Could not save workspace state: {}", errors), accept)
    }

    void performProjectOp(String op) {
        if (op.equals("save")) {
            status.setText(format("Project saved: {}", activeProject.name))
            return
        }
        if (op.equals("configure")) {
            if (configureMessage != null) { configureMessage.setText("Project configuration saved") }
            status.setText("Project configuration saved")
            return
        }
        if (op.equals("open")) {
            TweedProject target = nextProject
            nextProject = null
            closeAllDocuments()
            activateProject(target, true)
            return
        }
        if (op.equals("new")) {
            writeProject(nextProject, true, true, "activate")
            return
        }
        if (op.equals("activate")) {
            TweedProject created = nextProject
            nextProject = null
            created.parseWorkspace(created.workspaceOriginal)
            activateProject(created, false)
            status.setText(format("Project saved in {}", created.root))
            return
        }
        if (op.equals("folder")) {
            detachProject()
            project.setRoot(nextFolder)
            nextFolder = ""
            return
        }
        if (op.equals("quit")) {
            quitReady = true
            allowWindowClose = true
            window.close()
        }
    }

    void askConfirm(String op, String message, String accept) {
        confirmOp = op
        confirmLabel.setText(message)
        confirmButton.setLabel(accept)
        confirmChoices.setVisible(true)
        status.setText(message)
        updateMenu()
    }

    void acceptConfirm() {
        String op = confirmOp
        confirmOp = ""
        confirmChoices.setVisible(false)
        updateMenu()
        if (op.equals("delete")) { deleteProjectMetadata() }
        if (op.equals("replace-new")) { startNewProject("new") }
        if (op.equals("replace-save-as")) { startNewProject("save-as") }
        if (op.startsWith("continue-")) { performProjectOp(op.slice(9, op.length)) }
    }

    void cancelConfirm() {
        String op = confirmOp
        confirmOp = ""
        confirmChoices.setVisible(false)
        nextProject = null
        nextFolder = ""
        if (op.equals("continue-quit")) {
            allowWindowClose = false
            quitReady = false
        }
        status.setText("Cancelled")
        if (documents.length == 0) { newDocument() }
        updateMenu()
    }

    void closeAllDocuments() {
        int index = 0
        while (index < documents.length) {
            EditorDocument document = documents[index] as EditorDocument
            notebook.remove(document.scroller)
            document.scroller.dispose()
            index = index + 1
        }
        documents = []
    }

    void detachProject() {
        activeProject = null
        reapplyDocumentSettings()
        refreshProjectNote()
        if (configureWindow != null && !configureWindow.disposed()) { configureWindow.setVisible(false) }
        updateMenu()
    }

    void reapplyDocumentSettings() {
        int index = 0
        while (index < documents.length) {
            applyDocumentSettings(documents[index] as EditorDocument)
            index = index + 1
        }
    }

    list absolutePaths(TweedProject target, list paths) {
        list result = []
        int index = 0
        while (index < paths.length) {
            result.append(System.FileSystem().join(target.root, paths[index] as String))
            index = index + 1
        }
        return result
    }

    void activateProject(TweedProject target, bool restore) {
        activeProject = target
        project.setProject(target.root, target.name, target.excludeLines(), absolutePaths(target, target.expanded))
        reapplyDocumentSettings()
        refreshProjectNote()
        if (restore) {
            // Window size is restored only before the window is first shown.
            if (!presented && target.windowWidth > 0 && target.windowHeight > 0) {
                window.setDefaultSize(target.windowWidth, target.windowHeight)
            }
            if (target.explorerWidth >= 0) { workspace.setPosition(target.explorerWidth) }
            openFailures = []
            collectingFailures = true
            EditorDocument chosen = null
            int index = 0
            while (index < target.files.length) {
                WorkspaceFile item = target.files[index] as WorkspaceFile
                String path = System.FileSystem().join(target.root, item.path)
                if (!System.FileSystem().exists(path)) {
                    openFailures.append(format("Missing: {}", path))
                } else {
                    EditorDocument document = openDocument(path)
                    if (document != null) {
                        document.view.setCursor(item.line, item.column)
                        if (chosen == null || item.path.equals(target.active)) { chosen = document }
                    }
                }
                index = index + 1
            }
            collectingFailures = false
            if (documents.length == 0) { newDocument() } else { activateDocument(chosen) }
            if (openFailures.length > 0) {
                String details = ""
                index = 0
                while (index < openFailures.length) {
                    if (index > 0) { details.append("\n") }
                    details.append(openFailures[index] as String)
                    index = index + 1
                }
                Gtk.AlertDialog().show(window, "Some workspace files could not be reopened", details)
                openFailures = []
            }
        }
        rememberProject(target.root)
        updateMenu()
        status.setText(format("Project: {} ({})", target.name, target.root))
        if (!target.errors.equals("")) {
            Gtk.AlertDialog().show(window, "Project configuration errors", format("{}\n{}\nInvalid values are ignored; saving project configuration is disabled until the file is repaired and the project reopened.", target.configPath, target.errors))
        }
        if (!target.workspaceErrors.equals("")) {
            Gtk.AlertDialog().show(window, "Workspace state ignored", format("{}\nThe workspace was not restored and will not be overwritten; repair or remove .tweed/workspace.toml and reopen the project.", target.workspaceErrors))
        }
    }

    // Workspace TOML for documents/explorer state under source, written relative
    // to target. When they differ (Save As) only paths existing under target are kept.
    String captureWorkspace(String source, String target) {
        TweedProject origin = TweedProject(source)
        bool filter = !source.equals(target)
        String text = "version = 1\n\n[workspace]\n"
        EditorDocument current = currentDocument()
        String activePath = ""
        String fileList = "["
        int count = 0
        int index = 0
        while (index < documents.length) {
            EditorDocument document = documents[index] as EditorDocument
            String rel = ""
            if (!document.path.equals("")) { rel = origin.relative(document.path) }
            if (!rel.equals("") && filter && !System.FileSystem().isFile(System.FileSystem().join(target, rel))) { rel = "" }
            if (!rel.equals("")) {
                if (count > 0) { fileList.append(", ") }
                fileList.append("{ path = ")
                fileList.append(Gtk.Config().quote(rel))
                fileList.append(format(", line = {}, column = {} ", document.view.line(), document.view.column()))
                fileList.append("}")
                count = count + 1
                if (document == current) { activePath = rel }
            }
            index = index + 1
        }
        fileList.append("]")
        if (!activePath.equals("")) { text.append(format("active = {}\n", Gtk.Config().quote(activePath))) }
        int width = workspace.position()
        if (width >= 0 && width <= 5000) { text.append(format("explorer_width = {}\n", width)) }
        int windowWidth = window.defaultWidth()
        int windowHeight = window.defaultHeight()
        if (windowWidth >= 200 && windowWidth <= 10000 && windowHeight >= 150 && windowHeight <= 10000) {
            text.append(format("window_width = {}\nwindow_height = {}\n", windowWidth, windowHeight))
        }
        list folders = []
        if (project.rootPath.equals(source)) {
            list paths = project.expandedPaths()
            index = 0
            while (index < paths.length) {
                String rel = origin.relative(paths[index] as String)
                if (!rel.equals("") && filter && !System.FileSystem().isDir(System.FileSystem().join(target, rel))) { rel = "" }
                if (!rel.equals("")) { folders.append(rel) }
                index = index + 1
            }
        }
        text.append(format("expanded = {}\n", origin.quotedList(folders)))
        text.append("files = ")
        text.append(fileList)
        text.append("\n")
        return text
    }

    // ---- Configure Project ------------------------------------------------

    void createConfigure() {
        configureWindow = Gtk.TransientWindow("Configure Project")
        configureWindow.setTransientFor(window)
        configureWindow.setDefaultSize(640, 480)
        Gtk.Box root = Gtk.Box(Gtk.Box.VERTICAL, 6)
        configureName = preferenceEntry(root, "Project name", "")
        configureExcludes = preferenceEntry(root, "Explorer exclusions (comma-separated)", "")
        root.append(Gtk.Label("Editor overrides (unchecked settings inherit your Preferences)"))
        overrideRows = []
        addOverride(root, OverrideRow("font_family", "font family", false))
        addOverride(root, OverrideRow("font_size", "font size", false))
        addOverride(root, OverrideRow("tab_width", "tab width", false))
        addOverride(root, OverrideRow("insert_spaces", "insert spaces", true))
        addOverride(root, OverrideRow("line_numbers", "line numbers", true))
        addOverride(root, OverrideRow("wrap", "wrap", true))
        addOverride(root, OverrideRow("highlight_current_line", "highlight current line", true))
        Gtk.Box buttons = Gtk.Box(Gtk.Box.HORIZONTAL, 6)
        Gtk.Button inherit = Gtk.Button("Reset All to Inherit")
        Gtk.Button apply = Gtk.Button("Apply")
        Gtk.Button close = Gtk.Button("Close")
        inherit.onClicked(_self().inheritAll)
        apply.onClicked(_self().applyConfigure)
        close.onClicked(_self().closeConfigure)
        buttons.append(inherit)
        buttons.append(apply)
        buttons.append(close)
        root.append(buttons)
        configureMessage = Gtk.Label("")
        root.append(configureMessage)
        configureWindow.setChild(root)
        configureWindow.onCloseRequest(_self().hideConfigure)
        configureWindow.setVisible(false)
    }

    void addOverride(Gtk.Box root, OverrideRow row) {
        overrideRows.append(row)
        root.append(row.row)
    }

    OverrideRow overrideRow(String key) {
        int index = 0
        while (index < overrideRows.length) {
            OverrideRow row = overrideRows[index] as OverrideRow
            if (row.key.equals(key)) { return row }
            index = index + 1
        }
        return null
    }

    void showConfigure() {
        if (commandsBlocked() || activeProject == null) { return }
        if (configureWindow == null || configureWindow.disposed()) { createConfigure() }
        refreshConfigure()
        configureWindow.present()
    }

    void refreshConfigure() {
        TweedProject current = activeProject
        configureName.setText(current.name)
        String patterns = ""
        int index = 0
        while (index < current.excludes.length) {
            if (index > 0) { patterns.append(", ") }
            patterns.append(current.excludes[index] as String)
            index = index + 1
        }
        configureExcludes.setText(patterns)
        String font = settings.fontFamily
        if (current.hasFont) { font = current.fontFamily }
        int size = settings.fontSize
        if (current.hasSize) { size = current.fontSize }
        int tabs = settings.tabWidth
        if (current.hasTabs) { tabs = current.tabWidth }
        overrideRow("font_family").show(current.hasFont, font, false)
        overrideRow("font_size").show(current.hasSize, format("{}", size), false)
        overrideRow("tab_width").show(current.hasTabs, format("{}", tabs), false)
        bool flag = settings.insertSpaces
        if (current.hasSpaces) { flag = current.insertSpaces }
        overrideRow("insert_spaces").show(current.hasSpaces, "", flag)
        flag = settings.lineNumbers
        if (current.hasNumbers) { flag = current.lineNumbers }
        overrideRow("line_numbers").show(current.hasNumbers, "", flag)
        flag = settings.wrap
        if (current.hasWrap) { flag = current.wrap }
        overrideRow("wrap").show(current.hasWrap, "", flag)
        flag = settings.highlightLine
        if (current.hasHighlight) { flag = current.highlightLine }
        overrideRow("highlight_current_line").show(current.hasHighlight, "", flag)
        configureMessage.setText(current.errors)
    }

    void inheritAll() {
        int index = 0
        while (index < overrideRows.length) {
            OverrideRow row = overrideRows[index] as OverrideRow
            row.override.setActive(false)
            index = index + 1
        }
        configureMessage.setText("All editor settings inherit Preferences; press Apply to save")
    }

    void applyConfigure() {
        TweedProject current = activeProject
        if (current == null || commandsBlocked()) { return }
        if (!current.writable) {
            configureMessage.setText(format("Repair {} and reopen the project before changing it:\n{}", current.configPath, current.errors))
            return
        }
        String name = configureName.text().trim()
        String problem = current.nameError(name)
        list patterns = []
        list parts = configureExcludes.text().split(",")
        int index = 0
        while (index < parts.length) {
            String pattern = (parts[index] as String).trim()
            if (!pattern.equals("")) {
                String patternProblem = current.excludeError(pattern)
                if (problem.equals("")) { problem = patternProblem }
                patterns.append(pattern)
            }
            index = index + 1
        }
        OverrideRow fontRow = overrideRow("font_family")
        OverrideRow sizeRow = overrideRow("font_size")
        OverrideRow tabsRow = overrideRow("tab_width")
        int size = preferenceNumber(sizeRow.entry.text(), 6, 72)
        int tabs = preferenceNumber(tabsRow.entry.text(), 1, 16)
        if (problem.equals("") && fontRow.override.active()) { problem = settings.fontError(fontRow.entry.text()) }
        if (problem.equals("") && sizeRow.override.active() && size < 0) { problem = "Font size must be an integer from 6 to 72" }
        if (problem.equals("") && tabsRow.override.active() && tabs < 0) { problem = "Tab width must be an integer from 1 to 16" }
        if (!problem.equals("")) {
            configureMessage.setText(problem)
            return
        }
        String oldExcludes = current.excludeLines()
        current.name = name
        current.excludes = patterns
        current.hasFont = fontRow.override.active()
        if (current.hasFont) { current.fontFamily = fontRow.entry.text() }
        current.hasSize = sizeRow.override.active()
        if (current.hasSize) { current.fontSize = size }
        current.hasTabs = tabsRow.override.active()
        if (current.hasTabs) { current.tabWidth = tabs }
        OverrideRow row = overrideRow("insert_spaces")
        current.hasSpaces = row.override.active()
        current.insertSpaces = row.value.active()
        row = overrideRow("line_numbers")
        current.hasNumbers = row.override.active()
        current.lineNumbers = row.value.active()
        row = overrideRow("wrap")
        current.hasWrap = row.override.active()
        current.wrap = row.value.active()
        row = overrideRow("highlight_current_line")
        current.hasHighlight = row.override.active()
        current.highlightLine = row.value.active()
        reapplyDocumentSettings()
        refreshProjectNote()
        project.title.setText(current.name)
        if (!oldExcludes.equals(current.excludeLines())) {
            project.setProject(current.root, current.name, current.excludeLines(), project.expandedPaths())
        }
        configureMessage.setText("Saving project configuration...")
        writeProject(current, true, false, "configure")
    }

    bool hideConfigure() {
        if (configureWindow != null && !configureWindow.disposed()) { configureWindow.setVisible(false) }
        return true
    }
    void closeConfigure() { hideConfigure() }

    // ---- About ---------------------------------------------------------------

    void showAbout() {
        if (fileDialog != null) { return }
        if (aboutWindow == null || aboutWindow.disposed()) {
            aboutWindow = Gtk.TransientWindow("About Tweed")
            aboutWindow.setTransientFor(window)
            aboutWindow.setDefaultSize(480, 300)
            Gtk.Box root = Gtk.Box(Gtk.Box.VERTICAL, 8)
            root.append(Gtk.Label("Tweed Lang Editor"))
            root.append(Gtk.Label(format("Version {}", version())))
            root.append(Gtk.Label("A GTK editor for Simple (Tweed Lang), written in Simple\nwith GtkSourceView syntax highlighting, a project explorer,\nand per-project configuration."))
            root.append(Gtk.Label("License: no license file is included in the repository."))
            root.append(Gtk.Label("Project: https://github.com/chucktilbury/simp"))
            Gtk.Button close = Gtk.Button("Close")
            close.onClicked(_self().closeAbout)
            root.append(close)
            aboutWindow.setChild(root)
            aboutWindow.onCloseRequest(_self().hideAbout)
        }
        aboutWindow.present()
    }

    bool hideAbout() {
        if (aboutWindow != null && !aboutWindow.disposed()) { aboutWindow.setVisible(false) }
        return true
    }
    void closeAbout() { hideAbout() }

    void newDocument() {
        if (commandsBlocked()) { return }
        EditorDocument document = EditorDocument("", "")
        documents.append(document)
        notebook.appendPage(document.scroller, document.tabTitle())
        configureShortcuts(document)
        activateDocument(document)
    }

    EditorDocument openDocument(String requestedPath) {
        if (requestedPath.equals("") || requestedPath.equals("--test")) {
            return null
        }
        if (requestedPath.contains("://")) {
            reportOpenFailure(format("Open failed: {}: only local filesystem paths are supported",
                                     requestedPath), false)
            return null
        }
        String absolutePath = System.FileSystem().absolutePath(requestedPath)
        if (absolutePath.equals("")) {
            showError("Open failed: ", requestedPath)
            reportOpenFailure(status.text(), false)
            return null
        }
        int index = 0
        while (index < documents.length) {
            EditorDocument existing = documents[index] as EditorDocument
            if (existing.path.equals(absolutePath)) {
                rememberRecent(absolutePath)
                return existing
            }
            index = index + 1
        }
        if (!System.FileSystem().isFile(absolutePath)) {
            reportOpenFailure(format("Open failed: {} is not a regular file", requestedPath), false)
            return null
        }
        System.File input = System.File(absolutePath, "r")
        if (!input.isOpen()) {
            showError("Open failed: ", requestedPath)
            reportOpenFailure(status.text(), false)
            return null
        }
        String text = ""
        String readError = ""
        bool binary = false
        try {
            text = input.readAll()
            readError = System.System().lastError()
        } except(Exception) as error {
            readError = error.message
            binary = readError.contains("UTF-8")
        }
        input.close()
        if (binary || (readError.equals("") && !GtkSource.Content().isText(text))) {
            reportOpenFailure(format("Open failed: {} is not a text file (binary or not UTF-8)",
                                     absolutePath), true)
            return null
        }
        if (!readError.equals("")) {
            reportOpenFailure(format("Open failed: {}: {}", absolutePath, readError), false)
            return null
        }
        EditorDocument document = EditorDocument(absolutePath, text)
        documents.append(document)
        notebook.appendPage(document.scroller, document.tabTitle())
        configureShortcuts(document)
        rememberRecent(absolutePath)
        return document
    }

    // Single opens report on the status line (and in a dialog for files that
    // are not text); a chooser batch collects failures for one dialog.
    void reportOpenFailure(String message, bool dialog) {
        status.setText(message)
        if (collectingFailures) {
            openFailures.append(message)
        } else {
            if (dialog) {
                Gtk.AlertDialog().show(window, "Could not open file", message)
            }
        }
    }

    void activateDocument(EditorDocument document) {
        if (document == null) {
            return
        }
        int index = 0
        while (index < documents.length) {
            if ((documents[index] as EditorDocument) == document) {
                notebook.setCurrentPage(index)
                updateStatus()
                document.view.focus()
                return
            }
            index = index + 1
        }
        status.setText("Document is not open")
    }

    void openFile(String requestedPath) {
        EditorDocument document = openDocument(requestedPath)
        if (document != null) {
            activateDocument(document)
        }
    }

    EditorDocument currentDocument() {
        int page = notebook.currentPage()
        if (page < 0 || page >= documents.length) {
            return null
        }
        return documents[page] as EditorDocument
    }

    void saveCurrent() {
        if (commandsBlocked()) { return }
        EditorDocument document = currentDocument()
        if (document == null) {
            status.setText("No document to save")
            return
        }
        String destination = document.path
        if (destination.equals("")) {
            chooseSave(document, false)
            return
        }
        writeDocument(document, destination)
    }

    void saveAsCurrent() {
        if (commandsBlocked()) { return }
        EditorDocument document = currentDocument()
        if (document == null) {
            status.setText("No document to save")
            return
        }
        chooseSave(document, false)
    }

    bool writeDocument(EditorDocument document, String destination) {
        if (destination.equals("")) {
            status.setText("Save failed: empty file path")
            closeSearchDialog()
            return false
        }
        if (destination.contains("://")) {
            status.setText("Save failed: only local filesystem paths are supported")
            return false
        }
        String absoluteDestination = destination
        if (!absoluteDestination.startsWith("/")) {
            absoluteDestination = System.FileSystem().join(
                System.FileSystem().getCwd(), absoluteDestination)
        }
        absoluteDestination = System.FileSystem().normalize(absoluteDestination)
        if (System.FileSystem().exists(absoluteDestination)) {
            if (!System.FileSystem().isFile(absoluteDestination)) {
                status.setText("Save failed: destination is not a regular file")
                return false
            }
            absoluteDestination = System.FileSystem().absolutePath(absoluteDestination)
        } else {
            String parent = System.FileSystem().absolutePath(
                System.FileSystem().dirname(absoluteDestination))
            if (parent.equals("")) {
                showError("Save failed: ", destination)
                return false
            }
            absoluteDestination = System.FileSystem().join(parent,
                System.FileSystem().basename(absoluteDestination))
        }
        int index = 0
        while (index < documents.length) {
            EditorDocument other = documents[index] as EditorDocument
            if (other != document && other.path.equals(absoluteDestination)) {
                status.setText("Save failed: destination belongs to another open document")
                return false
            }
            index = index + 1
        }
        System.File output = System.File(absoluteDestination, "w")
        if (!output.isOpen()) {
            showError("Save failed: ", absoluteDestination)
            return false
        }
        String contents = document.view.text()
        int written = output.write(contents)
        String writeError = System.System().lastError()
        if (written != contents.length) {
            output.close()
            status.setText(format("Save failed: {}: {}", absoluteDestination, writeError))
            return false
        }
        output.flush()
        String flushError = System.System().lastError()
        output.close()
        String closeError = System.System().lastError()
        if (!flushError.equals("") || !closeError.equals("")) {
            status.setText(format("Save failed: {}: {} {}", absoluteDestination,
                                  flushError, closeError))
            return false
        }
        if (!document.path.equals(absoluteDestination)) {
            document.view.setLanguage(GtkSource.Content().languageFor(absoluteDestination))
        }
        document.path = absoluteDestination
        rememberRecent(absoluteDestination)
        document.view.markSaved()
        refreshTab(document)
        status.setText("Saved")
        updateMenu()
        return true
    }

    bool commandsBlocked() {
        return (fileDialog != null || pendingCloseAll || pendingCloseDocument != null ||
            projectSaves > 0 || !confirmOp.equals(""))
    }

    void chooseOpen() {
        if (commandsBlocked()) { return }
        String initialPath = ""
        if (currentDocument() != null) {
            initialPath = currentDocument().path
        }
        fileDialog = Gtk.FileDialog(window, initialPath, openResultAction)
        updateMenu()
    }

    void chooseFolder() {
        if (commandsBlocked()) { return }
        String initialPath = project.rootPath
        if (initialPath.equals("") && currentDocument() != null && !currentDocument().path.equals("")) {
            initialPath = System.FileSystem().dirname(currentDocument().path)
        }
        fileDialog = Gtk.FileDialog(window, initialPath, _self().folderOpened)
        updateMenu()
    }

    void folderOpened(String path) {
        fileDialog = null
        updateMenu()
        if (path.equals("")) {
            currentDocument().view.focus()
            return
        }
        if (path.contains("://")) {
            status.setText("Open folder failed: only local filesystem paths are supported")
            return
        }
        if (!path.startsWith("/")) {
            path = System.FileSystem().join(System.FileSystem().getCwd(), path)
        }
        if (activeProject != null) {
            String root = canonicalFolder(path, "Open folder failed")
            if (root.equals("")) { return }
            // Leaving a project saves its workspace state, then opens the folder without project settings.
            nextFolder = root
            beginSwitch("folder")
            return
        }
        project.setRoot(System.FileSystem().normalize(path))
    }

    void opened(list paths) {
        fileDialog = null
        openFailures = []
        collectingFailures = true
        EditorDocument last = null
        int index = 0
        while (index < paths.length) {
            EditorDocument document = openDocument(paths[index] as String)
            if (document != null) {
                last = document
            }
            index = index + 1
        }
        collectingFailures = false
        if (last != null) {
            activateDocument(last)
        }
        if (openFailures.length > 0) {
            String details = ""
            index = 0
            while (index < openFailures.length) {
                if (index > 0) {
                    details.append("\n")
                }
                details.append(openFailures[index] as String)
                index = index + 1
            }
            String title = "Some files could not be opened"
            if (openFailures.length == 1) {
                title = "Could not open file"
                status.setText(openFailures[0] as String)
            } else {
                status.setText(format("Open failed for {} of {} files", openFailures.length,
                                      paths.length))
            }
            Gtk.AlertDialog().show(window, title, details)
            openFailures = []
        }
        updateMenu()
    }

    void chooseSave(EditorDocument document, bool closing) {
        dialogDocument = document
        dialogClosing = closing
        fileDialog = Gtk.FileDialog(window, true, document.path, saveResultAction)
        updateMenu()
    }

    void savedAs(String path) {
        EditorDocument document = dialogDocument
        bool closing = dialogClosing
        fileDialog = null
        dialogDocument = null
        dialogClosing = false
        if (path.equals("")) {
            if (closing) { cancelPendingClose() }
            status.setText("Save As cancelled")
        } else {
            if (writeDocument(document, path) && closing) {
                continueSavedClose()
            }
        }
        updateMenu()
    }

    void quit() { window.close() }

    void openRecent() {
        if (commandsBlocked()) { return }
        if (recentFiles.length == 0) {
            status.setText("No recent files in this session")
            return
        }
        openFile(recentFiles[recentFiles.length - 1] as String)
    }

    void rememberRecent(String path) {
        int index = 0
        while (index < recentFiles.length) {
            if ((recentFiles[index] as String).equals(path)) {
                return
            }
            index = index + 1
        }
        recentFiles.append(path)
    }

    int searchOptions() {
        int options = 0
        if (caseCheck.active()) {
            options = options + GtkSource.View.CASE_SENSITIVE
        }
        if (wholeWordsCheck.active()) {
            options = options + GtkSource.View.WHOLE_WORDS
        }
        if (selectionCheck.active()) {
            options = options + GtkSource.View.IN_SELECTION
        }
        return options
    }

    EditorDocument searchDocument() {
        if (commandsBlocked()) { return null }
        EditorDocument document = currentDocument()
        if (document == null) {
            return null
        }
        if (selectionCheck.active() && !document.view.hasSearchScope()) {
            status.setText("In selection: select text, then press Find or Replace")
            return null
        }
        return document
    }

    void findNext() {
        EditorDocument document = searchDocument()
        if (document == null) {
            return
        }
        if (!document.view.findWith(findEntry.text(), searchOptions())) {
            status.setText("No match")
        } else {
            updateStatus()
        }
    }

    void replaceNext() {
        EditorDocument document = searchDocument()
        if (document == null) {
            return
        }
        if (!document.view.replaceWith(findEntry.text(), replaceEntry.text(), searchOptions())) {
            status.setText("No match")
        } else {
            updateStatus()
        }
    }

    void replaceAll() {
        EditorDocument document = searchDocument()
        if (document == null) {
            return
        }
        int count = document.view.replaceAll(findEntry.text(), replaceEntry.text(),
                                             searchOptions())
        if (count == 0) {
            status.setText("No match")
        } else {
            updateMenu()
            status.setText(format("Replaced {} occurrences", count))
        }
    }

    void undoCurrent() {
        if (commandsBlocked()) { return }
        EditorDocument document = currentDocument()
        if (document != null) {
            document.view.undo()
        }
    }

    void redoCurrent() {
        if (commandsBlocked()) { return }
        EditorDocument document = currentDocument()
        if (document != null) {
            document.view.redo()
        }
    }

    void cutCurrent() {
        if (!commandsBlocked() && currentDocument() != null) { currentDocument().view.cut() }
    }

    void copyCurrent() {
        if (!commandsBlocked() && currentDocument() != null) { currentDocument().view.copy() }
    }

    void pasteCurrent() {
        if (!commandsBlocked() && currentDocument() != null) { currentDocument().view.paste() }
    }

    void selectAllCurrent() {
        if (!commandsBlocked() && currentDocument() != null) { currentDocument().view.selectAll() }
    }

    // Captures the selection as the "In selection" scope before focus moves
    // to the search bar, and copies a single-line selection into Find.
    void prepareSearch() {
        EditorDocument document = currentDocument()
        if (document == null) {
            return
        }
        String selected = document.view.selectedText()
        document.view.captureSearchScope()
        if (!selected.equals("") && !selected.contains("\n")) {
            findEntry.setText(selected)
        }
    }

    void showFind() {
        if (!commandsBlocked()) {
            searchWindow.setTitle("Find")
            replaceRow.setVisible(false)
            prepareSearch()
            searchDialogOpen = true
            searchWindow.present()
            findEntry.focus()
        }
    }

    void showReplace() {
        if (!commandsBlocked()) {
            searchWindow.setTitle("Find and Replace")
            replaceRow.setVisible(true)
            prepareSearch()
            searchDialogOpen = true
            searchWindow.present()
            replaceEntry.focus()
        }
    }

    bool hideSearchDialog() {
        searchDialogOpen = false
        searchWindow.setVisible(false)
        return true
    }

    void closeSearchDialog() {
        searchDialogOpen = false
        if (searchWindow != null && !searchWindow.disposed()) {
            searchWindow.dispose()
        }
    }

    void changed() {
        EditorDocument document = currentDocument()
        if (document != null) {
            refreshTab(document)
        }
        updateStatus()
    }

    void pageChanged() {
        pageChanges = pageChanges + 1
        if (searchDialogOpen) {
            EditorDocument document = currentDocument()
            if (document != null && document.view.hasSelection()) {
                document.view.captureSearchScope()
            }
        }
        updateStatus()
    }

    void refreshTab(EditorDocument document) {
        int index = 0
        while (index < documents.length) {
            EditorDocument item = documents[index] as EditorDocument
            if (item == document) {
                notebook.setPageTitle(index, item.tabTitle())
                return
            }
            index = index + 1
        }
    }

    void updateStatus() {
        updateMenu()
        EditorDocument document = currentDocument()
        if (document == null) {
            return
        }
        String message = "Ln "
        message = format("Ln {}, Col {}", document.view.line(), document.view.column())
        if (document.view.modified()) {
            message.append("  Modified")
        }
        status.setText(message)
    }

    void updateMenu() {
        if (menu == null || status == null || window.disposed()) { return }
        bool ready = !commandsBlocked()
        EditorDocument document = currentDocument()
        bool editable = ready && document != null
        menu.setItemEnabled(newItem, ready)
        menu.setItemEnabled(openItem, ready)
        menu.setItemEnabled(openFolderItem, ready)
        project.sidebar.setSensitive(ready)
        menu.setItemEnabled(recentItem, ready && recentFiles.length > 0)
        menu.setItemEnabled(quitItem, fileDialog == null)
        menu.setItemEnabled(projectNewItem, ready)
        menu.setItemEnabled(projectOpenItem, ready)
        int projectIndex = 0
        while (projectIndex < projectItems.length) {
            menu.setItemEnabled(projectItems[projectIndex] as int, ready && activeProject != null)
            projectIndex = projectIndex + 1
        }
        menu.setItemEnabled(aboutItem, fileDialog == null)
        confirmChoices.setSensitive(fileDialog == null)
        int index = 0
        while (index < documentItems.length) {
            menu.setItemEnabled(documentItems[index] as int, editable)
            index = index + 1
        }
        bool canUndo = false
        bool canRedo = false
        bool selected = false
        if (editable) {
            canUndo = document.view.canUndo()
            canRedo = document.view.canRedo()
            selected = document.view.hasSelection()
        }
        menu.setItemEnabled(undoItem, canUndo)
        menu.setItemEnabled(redoItem, canRedo)
        menu.setItemEnabled(cutItem, selected)
        menu.setItemEnabled(copyItem, selected)
        notebook.setSensitive(fileDialog == null)
        closeChoices.setSensitive(fileDialog == null)
        findRow.setSensitive(ready)
        replaceRow.setSensitive(ready)
        optionsRow.setSensitive(ready)
    }

    bool workspaceNeedsSave() {
        return (activeProject != null && activeProject.workspaceWritable &&
            !activeProject.workspaceText.equals(activeProject.workspaceOriginal))
    }

    bool requestClose() {
        if (savePending || projectSaves > 0) {
            closeAfterSave = true
            status.setText("Waiting for settings to save")
            return true
        }
        if (allowWindowClose) {
            // Checked synchronously so window.close() is never re-entered from this handler.
            if (!quitReady && workspaceNeedsSave()) {
                writeProject(activeProject, false, true, "quit")
                return true
            }
            closePreferencesWindows()
            return false
        }
        if (fileDialog != null) {
            fileDialog.cancel()
            fileDialog = null
            dialogDocument = null
            dialogClosing = false
            chooserPurpose = ""
        }
        if (!confirmOp.equals("")) {
            confirmOp = ""
            confirmChoices.setVisible(false)
        }
        switchOp = ""
        nextProject = null
        nextFolder = ""
        if (activeProject != null) {
            activeProject.workspaceText = captureWorkspace(activeProject.root, activeProject.root)
        }
        int index = 0
        while (index < documents.length) {
            EditorDocument document = documents[index] as EditorDocument
            if (document.view.modified()) {
                pendingCloseAll = true
                pendingCloseDocument = null
                closeChoices.setVisible(true)
                status.setText("Unsaved changes: Save, Discard, or Cancel closing")
                updateMenu()
                return true
            }
            index = index + 1
        }
        if (workspaceNeedsSave()) {
            allowWindowClose = true
            writeProject(activeProject, false, true, "quit")
            return true
        }
        return false
    }

    void closePreferencesWindows() {
        closeSearchDialog()
        if (aboutWindow != null && !aboutWindow.disposed()) {
            aboutWindow.setVisible(false)
            aboutWindow.dispose()
        }
        if (configureWindow != null && !configureWindow.disposed()) {
            configureWindow.setVisible(false)
            configureWindow.dispose()
        }
        if (preferencesWindow != null && !preferencesWindow.disposed()) {
            hidePreferences()
            preferencesWindow.dispose()
        }
    }

    void closeCurrentDocument() {
        if (commandsBlocked()) { return }
        EditorDocument document = currentDocument()
        if (document == null) {
            return
        }
        if (document.view.modified()) {
            pendingCloseDocument = document
            pendingCloseAll = false
            closeChoices.setVisible(true)
            status.setText(format("Unsaved changes in {}: Save, Discard, or Cancel",
                                  document.tabTitle()))
            updateMenu()
            return
        }
        removeDocument(document)
    }

    void removeDocument(EditorDocument document) {
        int index = 0
        while (index < documents.length) {
            if ((documents[index] as EditorDocument) == document) {
                notebook.remove(document.scroller)
                document.scroller.dispose()
                list remaining = []
                int itemIndex = 0
                while (itemIndex < documents.length) {
                    EditorDocument item = documents[itemIndex] as EditorDocument
                    if (item != document) {
                        remaining.append(item)
                    }
                    itemIndex = itemIndex + 1
                }
                documents = remaining
                if (pendingCloseDocument == document) {
                    pendingCloseDocument = null
                }
                if (!pendingCloseAll) {
                    closeChoices.setVisible(false)
                }
                if (documents.length == 0 && !pendingCloseAll) {
                    newDocument()
                } else {
                    updateStatus()
                    EditorDocument next = currentDocument()
                    if (next != null && !pendingCloseAll) {
                        next.view.focus()
                    }
                }
                return
            }
            index = index + 1
        }
    }

    EditorDocument firstModifiedDocument() {
        int index = 0
        while (index < documents.length) {
            EditorDocument document = documents[index] as EditorDocument
            if (document.view.modified()) {
                return document
            }
            index = index + 1
        }
        return null
    }

    void savePendingClose() {
        if (fileDialog != null) { return }
        EditorDocument document = pendingCloseDocument
        if (pendingCloseAll) {
            document = firstModifiedDocument()
        }
        if (document == null) {
            finishPendingClose()
            return
        }
        activateDocument(document)
        String destination = document.path
        if (destination.equals("")) {
            chooseSave(document, true)
            return
        }
        if (!writeDocument(document, destination)) {
            return
        }
        continueSavedClose()
    }

    void continueSavedClose() {
        if (!pendingCloseAll) {
            finishPendingClose()
            return
        }
        if (firstModifiedDocument() == null) {
            finishPendingClose()
        } else {
            status.setText("Saved. Save or discard the remaining modified tabs")
        }
    }

    void discardPendingClose() {
        if (pendingCloseAll && !switchOp.equals("")) {
            pendingCloseAll = false
            closeChoices.setVisible(false)
            continueSwitch(switchOp)
            return
        }
        if (pendingCloseAll) {
            window.setVisible(false)
            closeAllDocuments()
            pendingCloseAll = false
            pendingCloseDocument = null
            closeChoices.setVisible(false)
            allowWindowClose = true
            window.close()
            return
        }
        EditorDocument document = pendingCloseDocument
        if (document != null) {
            removeDocument(document)
        }
        pendingCloseDocument = null
        closeChoices.setVisible(false)
    }

    void cancelPendingClose() {
        if (!switchOp.equals("")) {
            switchOp = ""
            nextProject = null
            status.setText("Cancelled opening the project")
        }
        pendingCloseDocument = null
        pendingCloseAll = false
        closeChoices.setVisible(false)
        updateStatus()
    }

    void finishPendingClose() {
        if (pendingCloseAll && !switchOp.equals("")) {
            pendingCloseAll = false
            closeChoices.setVisible(false)
            continueSwitch(switchOp)
            return
        }
        if (pendingCloseAll) {
            pendingCloseAll = false
            pendingCloseDocument = null
            closeChoices.setVisible(false)
            allowWindowClose = true
            window.close()
            return
        }
        EditorDocument document = pendingCloseDocument
        pendingCloseDocument = null
        closeChoices.setVisible(false)
        if (document != null) {
            removeDocument(document)
        }
    }

    void showError(String prefix, String path) {
        String message = prefix
        message.append(path)
        message.append(": ")
        message.append(System.System().lastError())
        status.setText(message)
    }

    void test() {
        EditorDocument document = currentDocument()
        openFile("/path/that/does/not/exist/test.simp")
        bool badOpen = status.text().contains("Open failed") && documents.length == 2
        openFile(System.FileSystem().tempDir())
        bool directoryRejected = status.text().contains("not a regular file") && documents.length == 2
        document.view.setText("class Demo {\n  // note\n  String name = \"Tweed\"\n  int count = 12\n}\n")
        bool tabs = documents.length == 2 && notebook.pageCount() == 2 && recentFiles.length == 2
        bool tabSwitchUpdatesStatus = pageChanges > 0
        bool remapped = false
        bool defaults = false
        if (System.FileSystem().exists("tweed-shortcuts.conf")) {
            remapped = document.view.hasShortcut("<Control><Alt>s") && !document.view.hasShortcut("<Control>s")
        } else {
            defaults = document.view.hasShortcut("<Control>s") && document.view.hasShortcut("<Control>o")
        }
        bool conflicted = document.shortcutConflict
        bool plainText = GtkSource.Content().languageFor("notes.txt").equals("") && document.view.language().equals("tweed")
        bool highlighted = plainText && document.view.hasContextAt("keyword", 0) && document.view.hasContextAt("comment", 17) && document.view.hasContextAt("string", 39) && document.view.hasContextAt("number", 62)
        bool searched = document.view.find("Tweed")
        bool replaced = document.view.replaceNext("Tweed", "Tweed Lang")
        bool dirtyBlocked = requestClose()
        window.close()
        bool dirtyCloseCancelled = !window.disposed()
        cancelPendingClose()
        closeCurrentDocument()
        cancelPendingClose()
        bool tabCloseCancelled = documents.length == 2 && document.view.modified()
        document.view.undo()
        bool undoRestored = document.view.text().contains("name = \"Tweed\"") && !document.view.text().contains("Tweed Lang")
        document.view.redo()
        bool undoRedo = document.view.text().contains("Tweed Lang")
        closeCurrentDocument()
        savePendingClose()
        bool saved = false
        System.File savedFile = System.File(document.path, "r")
        if (savedFile.isOpen()) {
            String savedContents = savedFile.readAll()
            saved = savedContents.contains("String name = \"Tweed Lang\"")
            savedFile.close()
        }
        bool savedTabClosed = documents.length == 1 && notebook.pageCount() == 1
        bool closeProtected = !requestClose()
        newDocument()
        EditorDocument discarded = currentDocument()
        discarded.view.setText("discard this")
        closeCurrentDocument()
        discardPendingClose()
        bool tabDiscarded = documents.length == 1 && notebook.pageCount() == 1
        EditorDocument remaining = currentDocument()
        remaining.view.setText("discard all")
        bool windowClosePrompted = requestClose()
        cancelPendingClose()
        bool windowCloseCancelled = !window.disposed() && documents.length == 1
        remaining.view.setText("discard all")
        bool windowClosePromptedAgain = requestClose()
        discardPendingClose()
        bool windowDiscarded = windowClosePrompted && windowClosePromptedAgain && window.disposed()
        print(badOpen && directoryRejected && tabs && tabSwitchUpdatesStatus &&
              (remapped || defaults) && conflicted == remapped && highlighted &&
              searched && replaced && undoRestored && undoRedo && dirtyBlocked &&
              dirtyCloseCancelled && tabCloseCancelled && saved && savedTabClosed &&
              closeProtected && tabDiscarded && windowCloseCancelled && windowDiscarded)
    }
}

TweedEditor TweedEditor._self() from "simp_gtk_self"

start {
    Gtk.Application app = Gtk.Application("org.tweed.Editor")
    TweedEditor editor = TweedEditor()
    editor.changedAction = editor.changed
    editor.cursorAction = editor.updateStatus
    editor.pageChangedAction = editor.pageChanged
    editor.openAction = editor.chooseOpen
    editor.recentAction = editor.openRecent
    editor.saveAction = editor.saveCurrent
    editor.saveAsAction = editor.saveAsCurrent
    editor.newAction = editor.newDocument
    editor.closeTabAction = editor.closeCurrentDocument
    editor.closeSaveAction = editor.savePendingClose
    editor.closeDiscardAction = editor.discardPendingClose
    editor.closeCancelAction = editor.cancelPendingClose
    editor.findAction = editor.findNext
    editor.replaceAction = editor.replaceNext
    editor.replaceAllAction = editor.replaceAll
    editor.undoAction = editor.undoCurrent
    editor.redoAction = editor.redoCurrent
    editor.quitAction = editor.quit
    editor.cutAction = editor.cutCurrent
    editor.copyAction = editor.copyCurrent
    editor.pasteAction = editor.pasteCurrent
    editor.selectAllAction = editor.selectAllCurrent
    editor.showFindAction = editor.showFind
    editor.showReplaceAction = editor.showReplace
    editor.searchCloseAction = editor.hideSearchDialog
    editor.openResultAction = editor.opened
    editor.saveResultAction = editor.savedAs
    editor.closeAction = editor.requestClose
    editor.testAction = editor.test
    editor.preferencesAction = editor.showPreferences
    app.onActivate(editor.activate)
    app.run()
    app.shutdown()
}
