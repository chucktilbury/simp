    bool Widget._disposed(int token) from "simp_gtk_widget_disposed"
    void Widget._visible(int token, bool value) from "simp_gtk_widget_visible"
    void Widget._sensitive(int token, bool value) from "simp_gtk_widget_sensitive"
    void Widget._textSet(int token, String text) from "simp_gtk_widget_text_set"
    String Widget._textGet(int token) from "simp_gtk_widget_text_get"
