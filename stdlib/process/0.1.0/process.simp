namespace Process {
    class Runtime {
        handle spawn(String executable, list arguments)
        bool wait(handle process)
        int exitCode(handle process)
        String stdout(handle process)
        String stderr(handle process)
        void close(handle process)

        handle asyncStart(String executable, list arguments, String workingDirectory)
        handle asyncNext(handle process, int timeoutMilliseconds)
        int asyncEventKind(handle event)
        buffer asyncEventData(handle event)
        void asyncEventRelease(handle event)
        bool asyncWait(handle process, int timeoutMilliseconds)
        bool asyncCancel(handle process, int graceMilliseconds)
        int asyncState(handle process)
        int asyncExitCode(handle process)
        int asyncSignal(handle process)
        String asyncError(handle process)
        void asyncShutdown(handle process)
        void asyncClose(handle process)
        String textDecode(buffer bytes)
        int textIncompleteTail(buffer bytes)
    }

    class Process {
        private:
        handle _native

        public:
        Process(String executable, list arguments) {
            _native = Runtime().spawn(executable, arguments)
        }

        bool started() {
            return _native != null
        }

        bool wait() {
            return Runtime().wait(_native)
        }

        int exitCode() {
            return Runtime().exitCode(_native)
        }

        String stdout() {
            return Runtime().stdout(_native)
        }

        String stderr() {
            return Runtime().stderr(_native)
        }

        void close() {
            if (_native != null) {
                Runtime().close(_native)
                _native = null
            }
        }
    }

    class ProcessEvent {
        public:
        enum {
            STDOUT = 1,
            STDERR,
            COMPLETED
        }

        private:
        int _kind
        buffer _data

        public:
        ProcessEvent(int kind, buffer data) {
            _kind = kind
            _data = data
        }

        int kind() {
            return _kind
        }

        bool isStdout() {
            return _kind == ProcessEvent.STDOUT
        }

        bool isStderr() {
            return _kind == ProcessEvent.STDERR
        }

        bool isCompleted() {
            return _kind == ProcessEvent.COMPLETED
        }

        buffer data() {
            return _data
        }
    }

    class OutputDecoder {
        private:
        buffer _pending

        public:
        OutputDecoder() {
            _pending = buffer[]
        }

        String decode(buffer chunk) {
            if (chunk != null) {
                int index = 0
                while (index < chunk.length) {
                    _pending.append(chunk[index])
                    index = index + 1
                }
            }
            int complete = _pending.length - Runtime().textIncompleteTail(_pending)
            buffer ready = _pending[0:complete]
            _pending = _pending[complete:]
            return Runtime().textDecode(ready)
        }

        String finish() {
            String rest = Runtime().textDecode(_pending)
            _pending = buffer[]
            return rest
        }

        int pending() {
            return _pending.length
        }
    }

    class AsyncProcess {
        public:
        enum {
            RUNNING = 0,
            EXITED,
            SIGNALED,
            CANCELLED,
            LAUNCH_FAILED,
            WAIT_FAILED
        }

        private:
        handle _native
        bool _closed
        int _state
        int _exitCode
        int _signal
        String _error

        void launch(String executable, list arguments, String workingDirectory) {
            _closed = false
            _native = Runtime().asyncStart(executable, arguments, workingDirectory)
        }

        public:
        AsyncProcess(String executable, list arguments) {
            launch(executable, arguments, null)
        }

        AsyncProcess(String executable, list arguments, String workingDirectory) {
            launch(executable, arguments, workingDirectory)
        }

        bool started() {
            return state() != AsyncProcess.LAUNCH_FAILED
        }

        ProcessEvent next(int timeoutMilliseconds) {
            if (_closed) {
                return null
            }
            handle raw = Runtime().asyncNext(_native, timeoutMilliseconds)
            if (raw == null) {
                return null
            }
            int kind = Runtime().asyncEventKind(raw)
            buffer data = Runtime().asyncEventData(raw)
            ProcessEvent event = ProcessEvent(kind, data)
            Runtime().asyncEventRelease(raw)
            return event
        }

        bool wait(int timeoutMilliseconds) {
            if (_closed) {
                return true
            }
            return Runtime().asyncWait(_native, timeoutMilliseconds)
        }

        bool finished() {
            return wait(0)
        }

        bool cancel(int graceMilliseconds) {
            if (_closed) {
                return false
            }
            return Runtime().asyncCancel(_native, graceMilliseconds)
        }

        int state() {
            if (_closed) {
                return _state
            }
            return Runtime().asyncState(_native)
        }

        int exitCode() {
            if (_closed) {
                return _exitCode
            }
            return Runtime().asyncExitCode(_native)
        }

        int signal() {
            if (_closed) {
                return _signal
            }
            return Runtime().asyncSignal(_native)
        }

        String error() {
            if (_closed) {
                return _error
            }
            return Runtime().asyncError(_native)
        }

        void close() {
            if (_closed) {
                return
            }
            Runtime().asyncShutdown(_native)
            if (_closed) {
                return
            }
            _state = Runtime().asyncState(_native)
            _exitCode = Runtime().asyncExitCode(_native)
            _signal = Runtime().asyncSignal(_native)
            _error = Runtime().asyncError(_native)
            handle native = _native
            _native = null
            _closed = true
            Runtime().asyncClose(native)
        }
    }

    handle Runtime.spawn(String executable, list arguments) from "simp_process_spawn"
    bool Runtime.wait(handle process) from "simp_process_wait"
    int Runtime.exitCode(handle process) from "simp_process_exit_code"
    String Runtime.stdout(handle process) from "simp_process_stdout"
    String Runtime.stderr(handle process) from "simp_process_stderr"
    void Runtime.close(handle process) from "simp_process_close"
    handle Runtime.asyncStart(String executable, list arguments, String workingDirectory) from "simp_process_async_start"
    handle Runtime.asyncNext(handle process, int timeoutMilliseconds) from "simp_process_async_next"
    int Runtime.asyncEventKind(handle event) from "simp_process_async_event_kind"
    buffer Runtime.asyncEventData(handle event) from "simp_process_async_event_data"
    void Runtime.asyncEventRelease(handle event) from "simp_process_async_event_release"
    bool Runtime.asyncWait(handle process, int timeoutMilliseconds) from "simp_process_async_wait"
    bool Runtime.asyncCancel(handle process, int graceMilliseconds) from "simp_process_async_cancel"
    int Runtime.asyncState(handle process) from "simp_process_async_state"
    int Runtime.asyncExitCode(handle process) from "simp_process_async_exit_code"
    int Runtime.asyncSignal(handle process) from "simp_process_async_signal"
    String Runtime.asyncError(handle process) from "simp_process_async_error"
    void Runtime.asyncShutdown(handle process) from "simp_process_async_shutdown"
    void Runtime.asyncClose(handle process) from "simp_process_async_close"
    String Runtime.textDecode(buffer bytes) from "simp_process_text_decode"
    int Runtime.textIncompleteTail(buffer bytes) from "simp_process_text_incomplete_tail"
}
